@page "/Sleep"
@model GarminTempApi.Pages.Sleep.TodayModel
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Globalization
@using System.Linq
@{
    Layout = "_Layout";

    var serializerOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    var previousUrl = Model.PreviousDate.HasValue
        ? Url.Page("/Sleep/Today", new { date = Model.PreviousDate.Value.ToString("yyyy-MM-dd") })
        : null;
    var nextUrl = Model.NextDate.HasValue
        ? Url.Page("/Sleep/Today", new { date = Model.NextDate.Value.ToString("yyyy-MM-dd") })
        : null;
    var selectedDateText = Model.SelectedDate?.ToString("dd MMM yy", CultureInfo.InvariantCulture);
    var detailJson = Model.Entry == null
        ? "null"
        : JsonSerializer.Serialize(new
        {
            totalSeconds = Model.Entry.TotalSleepSeconds,
            goalSeconds = Model.Entry.SleepGoalSeconds,
            stageSlices = Model.StageSlices,
            timeline = Model.StageTimeline,
            movement = Model.MovementSamples,
            resting = Model.RestingHeartRateSamples,
            bodyBattery = Model.BodyBatterySamples,
            startLocal = Model.Entry.SleepStartLocal,
            endLocal = Model.Entry.SleepEndLocal
        }, serializerOptions);
}

@if (!Model.HasData)
{
    <div class="alert alert-info">No sleep details available yet. Run a sync to view the latest night.</div>
}
else
{
    var entry = Model.Entry!;
    var timelineStart = Model.StageTimeline.Count > 0
        ? Model.StageTimeline.Min(segment => segment.Start)
        : entry.SleepStartLocal ?? entry.SleepStartGmt;
    var timelineEnd = Model.StageTimeline.Count > 0
        ? Model.StageTimeline.Max(segment => segment.End)
        : entry.SleepEndLocal ?? entry.SleepEndGmt;

    var timelineStartLocal = timelineStart?.Kind == DateTimeKind.Utc
        ? timelineStart.Value.ToLocalTime()
        : timelineStart;
    var timelineEndLocal = timelineEnd?.Kind == DateTimeKind.Utc
        ? timelineEnd.Value.ToLocalTime()
        : timelineEnd;

    <style>
        .sleep-today-donut {
            position: relative;
            width: 220px;
            height: 220px;
        }

        .sleep-donut-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .sleep-donut-center .value {
            font-size: 1.75rem;
            font-weight: 600;
        }

        .sleep-donut-center .label {
            font-size: 0.9rem;
            color: #6c757d;
        }

        .sleep-timeline-wrapper {
            height: 260px;
        }

        .sleep-timeline-wrapper canvas {
            height: 100% !important;
            width: 100% !important;
        }

        .sleep-stage-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.25rem 0.6rem;
            border-radius: 999px;
            background-color: #f8f9fa;
        }

        .sleep-stage-swatch {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            display: inline-block;
        }

        .sleep-nav-group .btn {
            min-width: 40px;
        }
    </style>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-2 sleep-nav-group">
            <a class="btn btn-outline-secondary@(Model.PreviousDate.HasValue ? string.Empty : " disabled")" href="@(Model.PreviousDate.HasValue ? previousUrl : "#")" role="button" aria-label="Previous night">&#x2039;</a>
            <div class="btn btn-outline-secondary disabled">@selectedDateText</div>
            <a class="btn btn-outline-secondary@(Model.NextDate.HasValue ? string.Empty : " disabled")" href="@(Model.NextDate.HasValue ? nextUrl : "#")" role="button" aria-label="Next night">&#x203A;</a>
        </div>
        <div class="btn-group" role="group" aria-label="Sleep view options">
            <a class="btn btn-primary active" href="/Sleep">1 Day</a>
            <a class="btn btn-outline-secondary" href="/Sleep/Trends">7 Days</a>
            <a class="btn btn-outline-secondary" href="/Sleep/Trends">4 Weeks</a>
            <a class="btn btn-outline-secondary" href="/Sleep/Trends">1 Year</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="sleep-today-donut mb-3">
                        <canvas id="sleepTodayDonut"></canvas>
                        <div class="sleep-donut-center">
                                <div class="value">@FormatDuration(entry.TotalSleepSeconds)</div>
                            <div class="label">Total Sleep</div>
                            @if (entry.SleepGoalSeconds.HasValue)
                            {
                                <div class="text-muted small">Goal @FormatDuration(entry.SleepGoalSeconds.Value)</div>
                                <div class="text-muted small">@FormatGoalDelta(Model.GoalDeltaSeconds)</div>
                            }
                            else
                            {
                                <div class="text-muted small">Goal not set</div>
                            }
                        </div>
                    </div>

                    <div class="w-100 mt-2">
                        <div class="row g-2 text-center">
                            <div class="col-6">
                                <div class="text-muted small">Deep</div>
                                <div class="fw-semibold">@FormatDuration(entry.DeepSleepSeconds)</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Light</div>
                                <div class="fw-semibold">@FormatDuration(entry.LightSleepSeconds)</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">REM</div>
                                <div class="fw-semibold">@FormatDuration(entry.RemSleepSeconds)</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Awake</div>
                                <div class="fw-semibold">@FormatDuration(entry.AwakeSeconds)</div>
                            </div>
                        </div>
                    </div>

                    <div class="w-100 mt-3 text-center">
                        <div class="text-muted small">Sleep Score</div>
                        <div class="fs-4 fw-semibold">@FormatNullable(entry.SleepScore, "0")</div>
                        @if (!string.IsNullOrWhiteSpace(Model.QualityLabel))
                        {
                            <div class="text-muted small">Quality: @Model.QualityLabel</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="text-muted small">Bed Time</div>
                            <div class="fw-semibold">@FormatTime(timelineStartLocal)</div>
                        </div>
                        <div>
                            <div class="text-muted small">Wake Time</div>
                            <div class="fw-semibold">@FormatTime(timelineEndLocal)</div>
                        </div>
                    </div>

                    <div class="sleep-timeline-wrapper mb-3 position-relative">
                        <canvas id="sleepTimelineChart"></canvas>
                    </div>

                    <div class="d-flex flex-wrap gap-2 small text-muted mb-3">
                        @foreach (var slice in Model.StageSlices)
                        {
                            <div class="sleep-stage-pill">
                                <span class="sleep-stage-swatch" style="background-color: @slice.Color"></span>
                                <span>@slice.Label</span>
                                <span class="fw-semibold">@FormatDuration(slice.Seconds)</span>
                            </div>
                        }
                    </div>

                    <div class="btn-group" role="group" aria-label="Timeline options">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-overlay="movement">Movement</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-overlay="resting">Resting HR</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-overlay="bodyBattery">Body Battery</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small">Notes</h6>
                    <textarea class="form-control" rows="5" placeholder="Add notes" disabled></textarea>
                    <div class="small text-muted mt-2">Notes syncing not supported.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small mb-3">Sleep Timeline Metrics</h6>
                    <div class="row g-3 text-center">
                        <div class="col-6 col-md-3">
                            <div class="text-muted small">Resting HR</div>
                            <div class="fw-semibold">
                                @if (entry.RestingHeartRate.HasValue)
                                {
                                    @($"{entry.RestingHeartRate.Value:0} bpm")
                                }
                                else
                                {
                                    @("--")
                                }
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted small">Body Battery Change</div>
                            <div class="fw-semibold">@FormatNullable(entry.BodyBatteryChange, "0")</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted small">Respiration</div>
                            <div class="fw-semibold">
                                @if (entry.AverageRespirationValue.HasValue)
                                {
                                    @($"{entry.AverageRespirationValue.Value:0.0} br/min")
                                }
                                else
                                {
                                    @("--")
                                }
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted small">Lowest SpO2</div>
                            <div class="fw-semibold">
                                @if (entry.LowestSpO2Value.HasValue)
                                {
                                    @($"{entry.LowestSpO2Value.Value:0}%")
                                }
                                else
                                {
                                    @("--")
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script id="sleepTodayData" type="application/json">@Html.Raw(detailJson)</script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0"></script>
    <script>
        (() => {
            const dataElement = document.getElementById('sleepTodayData');
            if (!dataElement) {
                return;
            }

            let payload;
            try {
                payload = JSON.parse(dataElement.textContent || 'null');
            } catch (error) {
                console.warn('Unable to parse sleep detail payload', error);
                return;
            }

            if (!payload) {
                return;
            }

            const stageLevels = [
                { key: 'Awake', label: 'Awake', value: 1, color: '#facc15' },
                { key: 'Light', label: 'Light sleep', value: 2, color: '#60a5fa' },
                { key: 'REM', label: 'REM sleep', value: 3, color: '#d946ef' },
                { key: 'Deep', label: 'Deep sleep', value: 4, color: '#1e3a8a' }
            ];

            const stageLookup = stageLevels.reduce((acc, entry) => {
                acc[entry.key] = entry;
                return acc;
            }, {});

            const stageValueLookup = stageLevels.reduce((acc, entry) => {
                acc[entry.value] = entry;
                return acc;
            }, {});

            const fallbackStageKey = 'Light';
            let stageSegments = [];

            const sleepStageBlocksPlugin = {
                id: 'sleepStageBlocks',
                beforeEvent(chart, args) {
                    if (!stageSegments.length) {
                        return;
                    }

                    const event = args.event;
                    if (!event) {
                        return;
                    }

                    const datasetIndex = chart.data.datasets.findIndex(ds => ds.role === 'stage');
                    if (datasetIndex < 0) {
                        return;
                    }

                    chart.$sleepStageBlocks = chart.$sleepStageBlocks || { activeIndex: -1 };
                    const store = chart.$sleepStageBlocks;

                    if (event.type === 'mouseout') {
                        if (store.activeIndex !== -1) {
                            store.activeIndex = -1;
                            chart.setActiveElements([]);
                            chart.tooltip.update();
                            chart.draw();
                        }
                        return;
                    }

                    if (event.type !== 'mousemove') {
                        return;
                    }

                    const xScale = chart.scales.x;
                    if (!xScale) {
                        return;
                    }

                    const value = xScale.getValueForPixel(event.x);
                    if (!Number.isFinite(value)) {
                        return;
                    }

                    let activeIndex = -1;
                    for (let i = 0; i < stageSegments.length; i++) {
                        const segment = stageSegments[i];
                        if (value >= segment.startValue && value <= segment.endValue) {
                            activeIndex = i;
                            break;
                        }
                    }

                    if (activeIndex === store.activeIndex) {
                        return;
                    }

                    store.activeIndex = activeIndex;
                    if (activeIndex === -1) {
                        chart.setActiveElements([]);
                    }
                    else {
                        const meta = chart.getDatasetMeta(datasetIndex);
                        if (!meta?.data?.length || activeIndex >= meta.data.length) {
                            return;
                        }
                        chart.setActiveElements([{ datasetIndex, index: activeIndex }]);
                    }

                    chart.tooltip.update();
                    chart.draw();
                },
                beforeDatasetsDraw(chart) {
                    if (!stageSegments.length) {
                        return;
                    }

                    const xScale = chart.scales.x;
                    const yScale = chart.scales.stage;
                    const chartArea = chart.chartArea;
                    if (!xScale || !yScale || !chartArea) {
                        return;
                    }

                    const ctx = chart.ctx;
                    ctx.save();
                    ctx.beginPath();
                    ctx.rect(chartArea.left, chartArea.top, chartArea.width, chartArea.height);
                    ctx.clip();

                    const activeIndex = chart.$sleepStageBlocks?.activeIndex ?? -1;

                    stageSegments.forEach((segment, index) => {
                        const definition = segment.definition;
                        const xStart = xScale.getPixelForValue(segment.start);
                        const xEnd = xScale.getPixelForValue(segment.end);
                        if (!Number.isFinite(xStart) || !Number.isFinite(xEnd) || xEnd <= xStart) {
                            return;
                        }

                        const value = definition.value;
                        const yTop = yScale.getPixelForValue(value + 0.5);
                        const yBottom = yScale.getPixelForValue(value - 0.5);
                        const top = Math.min(yTop, yBottom);
                        const height = Math.max(Math.abs(yBottom - yTop), 1);

                        ctx.fillStyle = definition.color;
                        ctx.strokeStyle = definition.color;
                        ctx.lineWidth = index === activeIndex ? 2 : 1;
                        ctx.globalAlpha = index === activeIndex ? 0.95 : 0.8;
                        ctx.beginPath();
                        ctx.rect(xStart, top, xEnd - xStart, height);
                        ctx.fill();
                        ctx.stroke();
                        ctx.globalAlpha = 1;
                    });

                    ctx.restore();
                }
            };

            const slices = Array.isArray(payload.stageSlices)
                ? payload.stageSlices.filter(slice => (slice?.seconds ?? 0) > 0)
                : [];

            if (slices.length) {
                const donutCtx = document.getElementById('sleepTodayDonut');
                if (donutCtx) {
                    new Chart(donutCtx, {
                        type: 'doughnut',
                        data: {
                            labels: slices.map(slice => slice.label),
                            datasets: [{
                                data: slices.map(slice => toHours(slice.seconds)),
                                backgroundColor: slices.map(slice => slice.color),
                                borderWidth: 0,
                                hoverOffset: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '70%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: context => {
                                            const stage = context.label || '';
                                            const seconds = (context.parsed ?? 0) * 3600;
                                            return `${stage}: ${formatDuration(seconds)}`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            }

            const timelineCtx = document.getElementById('sleepTimelineChart');
            if (timelineCtx && Array.isArray(payload.timeline) && payload.timeline.length) {
                stageSegments = normalizeTimeline(payload.timeline);
                if (stageSegments.length) {
                    const stageDataset = buildStageDataset(stageSegments);
                    const overlayState = createOverlayState();

                    const timelineChart = new Chart(timelineCtx, {
                        type: 'scatter',
                        data: {
                            datasets: [stageDataset]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            parsing: false,
                            animation: false,
                            interaction: { intersect: false, mode: 'nearest', axis: 'x' },
                            scales: buildTimelineScales(stageSegments),
                            plugins: {
                                legend: {
                                    display: false,
                                    labels: {
                                        usePointStyle: true,
                                        filter: (legendItem, chart) => {
                                            const dataset = chart?.data?.datasets?.[legendItem.datasetIndex];
                                            return dataset?.role !== 'stage';
                                        }
                                    }
                                },
                                tooltip: {
                                    intersect: false,
                                    callbacks: {
                                        title: context => context.length ? formatTooltipRange(context[0].raw) : '',
                                        label: context => buildStageTooltipLabel(context),
                                        afterLabel: context => buildStageTooltipDuration(context)
                                    }
                                },
                                sleepStageBlocks: {}
                            }
                        },
                        plugins: [sleepStageBlocksPlugin]
                    });

                    setupOverlayButtons(timelineChart, overlayState, payload);
                }
            }
            else if (timelineCtx) {
                stageSegments = [];
                console.warn('Sleep timeline payload missing or empty.', payload.timeline);
            }

            function buildTimelineScales(segments) {
                const first = segments[0];
                const last = segments[segments.length - 1];

                return {
                    x: {
                        type: 'time',
                        min: first?.start ?? null,
                        max: last?.end ?? null,
                        time: {
                            displayFormats: {
                                hour: 'h:mm a',
                                minute: 'h:mm a',
                                second: 'h:mm:ss a',
                                day: 'h:mm a'
                            },
                            tooltipFormat: 'dd MMM yy, h:mm a'
                        },
                        ticks: {
                            autoSkip: true,
                            maxTicksLimit: 8,
                            callback: value => formatClock(value)
                        },
                        title: {
                            display: true,
                            text: 'Time',
                            color: '#4b5563',
                            font: { size: 12 }
                        },
                        grid: { drawBorder: false }
                    },
                    stage: {
                        type: 'linear',
                        position: 'left',
                        min: 0.5,
                        max: stageLevels.length + 0.5,
                        ticks: {
                            stepSize: 1,
                            callback: value => {
                                const rounded = Math.round(value);
                                return stageValueLookup[rounded]?.label ?? '';
                            }
                        },
                        title: {
                            display: true,
                            text: 'Sleep Stage',
                            color: '#4b5563',
                            font: { size: 12 }
                        },
                        grid: {
                            drawTicks: false,
                            drawBorder: false
                        }
                    },
                    overlay: {
                        type: 'linear',
                        position: 'right',
                        display: false,
                        grid: { drawOnChartArea: false }
                    }
                };
            }

            function normalizeTimeline(timeline) {
                if (!Array.isArray(timeline)) {
                    return [];
                }

                return timeline
                    .map(segment => {
                        const start = toDate(segment.start);
                        const end = toDate(segment.end);
                        if (!start || !end || end <= start) {
                            return null;
                        }

                        const stageKey = normalizeStage(segment.stage);
                        const definition = getStageDefinition(stageKey);
                        const startValue = start.getTime();
                        const endValue = end.getTime();
                        const midpoint = new Date((startValue + endValue) / 2);

                        return {
                            start,
                            end,
                            stageKey,
                            definition,
                            startValue,
                            endValue,
                            midpoint
                        };
                    })
                    .filter(Boolean)
                    .sort((a, b) => a.startValue - b.startValue);
            }

            function buildStageDataset(segments) {
                return {
                    label: 'Sleep Stage',
                    role: 'stage',
                    type: 'scatter',
                    parsing: false,
                    data: segments.map(segment => ({
                        x: segment.midpoint,
                        y: segment.definition.value,
                        stage: segment.stageKey,
                        segmentStart: segment.start,
                        segmentEnd: segment.end
                    })),
                    pointRadius: 0,
                    pointHoverRadius: 0,
                    pointHitRadius: 14,
                    showLine: false,
                    yAxisID: 'stage',
                    xAxisID: 'x'
                };
            }

            function formatTooltipRange(raw) {
                const start = toDate(raw?.segmentStart);
                const end = toDate(raw?.segmentEnd);
                if (!start || !end) {
                    return '';
                }

                const sameDay = start.toDateString() === end.toDateString();
                const startLabel = start.toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
                const endLabel = sameDay
                    ? end.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
                    : end.toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

                return `${startLabel} – ${endLabel}`;
            }

            function getStageDefinition(stageKey) {
                return stageLookup[stageKey] ?? stageLookup[fallbackStageKey];
            }

            function normalizeStage(stage) {
                if (!stage) {
                    return fallbackStageKey;
                }

                const key = stage.toString().trim().toUpperCase();
                switch (key) {
                    case 'DEEP':
                    case 'SLEEP_DEEP':
                        return 'Deep';
                    case 'REM':
                    case 'SLEEP_REM':
                        return 'REM';
                    case 'AWAKE':
                    case 'WAKE':
                    case 'OUT_OF_BED':
                    case 'SLEEP_AWAKE':
                    case 'SLEEP_OUT_OF_BED':
                    case 'NOT_WORN':
                    case 'RESTLESS':
                    case 'SLEEP_RESTLESS':
                        return 'Awake';
                    case 'LIGHT':
                    case 'SLEEP_LIGHT':
                    case 'SLEEP_UNKNOWN':
                        return 'Light';
                    default:
                        return fallbackStageKey;
                }
            }

            function buildStageTooltipLabel(context) {
                const raw = context.raw;
                if (!raw || context.dataset?.role !== 'stage') {
                    return context.dataset?.label || '';
                }

                const stageEntry = getStageDefinition(raw.stage);
                return stageEntry.label;
            }

            function buildStageTooltipDuration(context) {
                const raw = context.raw;
                if (!raw || context.dataset?.role !== 'stage') {
                    return null;
                }

                const start = toDate(raw.segmentStart);
                const end = toDate(raw.segmentEnd);
                if (!start || !end) {
                    return null;
                }

                const durationSeconds = (end.getTime() - start.getTime()) / 1000;
                return `Duration: ${formatDuration(durationSeconds)}`;
            }

            function createOverlayState() {
                return {
                    movement: false,
                    resting: false,
                    bodyBattery: false
                };
            }

            function setupOverlayButtons(chart, overlayState, payload) {
                const buttons = document.querySelectorAll('[data-overlay]');
                buttons.forEach(button => {
                    button.addEventListener('click', () => {
                        const key = button.dataset.overlay;
                        if (!key) {
                            return;
                        }

                        const hasSamples = hasOverlaySamples(payload[key]);
                        if (!hasSamples) {
                            button.classList.remove('active');
                            return;
                        }

                        overlayState[key] = !overlayState[key];
                        button.classList.toggle('active', overlayState[key]);

                        updateOverlayDatasets(chart, overlayState, payload);
                    });

                    if (!hasOverlaySamples(payload[button.dataset.overlay])) {
                        button.classList.add('disabled');
                        button.setAttribute('disabled', 'disabled');
                    }
                });

                updateOverlayDatasets(chart, overlayState, payload);
            }

            function hasOverlaySamples(samples) {
                if (!Array.isArray(samples) || !samples.length) {
                    return false;
                }

                return samples.some(sample => {
                    const timestamp = toDate(sample?.timestamp);
                    return timestamp && typeof sample?.value === 'number' && !Number.isNaN(sample.value);
                });
            }

            function updateOverlayDatasets(chart, overlayState, payload) {
                const overlayDatasets = [];

                if (overlayState.movement && hasOverlaySamples(payload.movement)) {
                    const dataset = createLineDataset('Movement', payload.movement, '#10b981');
                    if (dataset) {
                        overlayDatasets.push(dataset);
                    }
                }

                if (overlayState.resting && hasOverlaySamples(payload.resting)) {
                    const dataset = createLineDataset('Resting HR', payload.resting, '#0ea5e9');
                    if (dataset) {
                        overlayDatasets.push(dataset);
                    }
                }

                if (overlayState.bodyBattery && hasOverlaySamples(payload.bodyBattery)) {
                    const dataset = createLineDataset('Body Battery', payload.bodyBattery, '#f97316');
                    if (dataset) {
                        overlayDatasets.push(dataset);
                    }
                }

                const baseDatasets = chart.data.datasets.filter(ds => ds.role === 'stage');
                chart.data.datasets = baseDatasets.length ? [...baseDatasets, ...overlayDatasets] : overlayDatasets;

                chart.options.plugins.legend.display = overlayDatasets.length > 0;
                chart.options.scales.overlay.display = overlayDatasets.length > 0;

                if (chart.$sleepStageBlocks) {
                    chart.$sleepStageBlocks.activeIndex = -1;
                }

                chart.setActiveElements([]);
                chart.update();
            }

            function createLineDataset(label, samples, color) {
                const points = samples
                    .map(sample => {
                        const timestamp = toDate(sample.timestamp);
                        if (!timestamp || typeof sample.value !== 'number' || Number.isNaN(sample.value)) {
                            return null;
                        }
                        return { x: timestamp, y: sample.value };
                    })
                    .filter(Boolean)
                    .sort((a, b) => a.x.getTime() - b.x.getTime());

                if (!points.length) {
                    return null;
                }

                return {
                    type: 'line',
                    label,
                    role: 'overlay',
                    parsing: false,
                    data: points,
                    borderColor: color,
                    backgroundColor: color,
                    borderWidth: 2,
                    tension: 0.3,
                    pointRadius: 0,
                    yAxisID: 'overlay'
                };
            }

            function toHours(seconds) {
                return Math.round((seconds / 3600) * 100) / 100;
            }

            function formatDuration(seconds) {
                if (typeof seconds !== 'number' || Number.isNaN(seconds)) {
                    return '';
                }

                const total = Math.max(0, Math.round(seconds));
                const hours = Math.floor(total / 3600);
                const minutes = Math.floor((total % 3600) / 60);
                return `${hours}h ${minutes.toString().padStart(2, '0')}m`;
            }

            function formatClock(value) {
                const date = toDate(value);
                if (!date) {
                    return '--';
                }
                return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
            }

            function toDate(value) {
                if (value == null) {
                    return null;
                }
                const date = new Date(value);
                return Number.isNaN(date.getTime()) ? null : date;
            }
        })();
    </script>
}

@functions {
    private static string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return ts.TotalHours >= 10 ? ts.ToString("hh\\:mm") : ts.ToString("h\\:mm");
    }

    private static string FormatTime(DateTime? timestamp)
    {
        return timestamp.HasValue ? timestamp.Value.ToString("h:mm tt") : "--";
    }

    private static string FormatNullable(double? value, string format)
    {
        return value.HasValue ? value.Value.ToString(format) : "--";
    }

    private static string FormatGoalDelta(double? seconds)
    {
        if (!seconds.HasValue)
        {
            return "--";
        }

        var direction = seconds >= 0 ? "above goal" : "below goal";
        var span = TimeSpan.FromSeconds(Math.Abs(seconds.Value));
        var parts = new System.Collections.Generic.List<string>();
        if (span.Hours > 0)
        {
            parts.Add($"{span.Hours}h");
        }
        parts.Add($"{span.Minutes:D2}m");
        return string.Join(' ', parts) + $" {direction}";
    }
}

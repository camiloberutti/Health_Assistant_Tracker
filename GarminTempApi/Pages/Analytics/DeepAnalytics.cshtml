@page "/Analytics"
@model GarminTempApi.Pages.Analytics.DeepAnalyticsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Deep Analytics";
}

<div class="pt-3 pb-2">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Deep Analytics</h1>
    <p class="text-muted mb-0">PCA, EFA, CCA, Clustering, Regression &amp; MDS on your health data</p>
</div>

<!-- ─── Configuration Card ──────────────────────────────────────── -->
<section class="mb-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title fs-6 mb-3">
                <i class="bi bi-sliders me-1"></i> Analysis Configuration
            </h5>
            <form id="analyticsForm" onsubmit="return false;">
                <div class="row g-3">
                    <!-- Date Range -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Start Date</label>
                        <input type="date" class="form-control" id="startDate" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">End Date</label>
                        <input type="date" class="form-control" id="endDate" required />
                    </div>

                    <!-- Method -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Method</label>
                        <select class="form-select" id="methodSelect">
                            <option value="PCA" selected>PCA – Principal Components</option>
                            <option value="EFA">EFA – Exploratory Factor Analysis</option>
                            <option value="CCA">CCA – Canonical Correlation</option>
                            <option value="CLUSTER">Clustering – K-Means &amp; Hierarchical</option>
                            <option value="REGRESSION">Regression – Multiple Linear</option>
                            <option value="MDS">MDS – Multidimensional Scaling</option>
                        </select>
                    </div>

                    <!-- EFA factors (visible only for EFA) -->
                    <div class="col-md-3 d-none" id="efaFactorsGroup">
                        <label class="form-label fw-semibold"># Factors</label>
                        <input type="number" class="form-control" id="nFactors" value="5" min="2" max="15" />
                    </div>

                    <!-- Cluster K (visible only for CLUSTER) -->
                    <div class="col-md-3 d-none" id="clusterKGroup">
                        <label class="form-label fw-semibold"># Clusters (K)</label>
                        <input type="number" class="form-control" id="nClusters" value="3" min="2" max="10" />
                    </div>

                    <!-- Linkage method (visible only for CLUSTER) -->
                    <div class="col-md-3 d-none" id="linkageGroup">
                        <label class="form-label fw-semibold">Linkage</label>
                        <select class="form-select" id="linkageMethod">
                            <option value="complete" selected>Complete</option>
                            <option value="single">Single</option>
                            <option value="average">Average</option>
                            <option value="ward.D2">Ward's</option>
                        </select>
                    </div>

                    <!-- Regression target (visible only for REGRESSION) -->
                    <div class="col-md-3 d-none" id="regressionTargetGroup">
                        <label class="form-label fw-semibold">Target (Y)</label>
                        <select class="form-select" id="regressionTarget">
                            <option value="">— select after scanning —</option>
                        </select>
                    </div>

                    <!-- Compositional warning (shown when tautological predictors detected) -->
                    <div class="col-12 d-none" id="compositionalWarning">
                        <div class="alert alert-warning py-2 mb-0 d-flex align-items-start gap-2">
                            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                            <div>
                                <strong>Compositional warning:</strong>
                                <span id="compositionalWarningText"></span>
                                <br><small class="text-muted" id="compositionalExcludedVars"></small>
                            </div>
                        </div>
                    </div>

                    <!-- MDS dimensions (visible only for MDS) -->
                    <div class="col-md-3 d-none" id="mdsDimsGroup">
                        <label class="form-label fw-semibold">Dimensions</label>
                        <select class="form-select" id="mdsDims">
                            <option value="2" selected>2D</option>
                            <option value="3">3D</option>
                        </select>
                    </div>
                </div>

                <!-- Variable Selection -->
                <div class="mt-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <label class="form-label fw-semibold mb-0">Variables</label>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2" type="button" id="scanBtn"
                                onclick="scanDensity()" title="Scan which variables have data in this range">
                            <i class="bi bi-arrow-clockwise"></i> Scan
                        </button>
                        <div class="spinner-border spinner-border-sm text-secondary d-none" id="densitySpinner"
                             role="status"></div>
                        <small class="text-muted ms-1" id="densityStatus"></small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Min data density</label>
                        <div class="d-flex align-items-center gap-2" style="max-width:260px;">
                            <input type="range" class="form-range" id="densitySlider" min="0" max="100" value="10"
                                   step="5"
                                   oninput="document.getElementById('densityLabel').textContent = this.value + '%'" />
                            <span class="badge bg-secondary" id="densityLabel" style="min-width:40px;">10%</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2" id="variableCheckboxes">
                        <span class="text-muted small"><i class="bi bi-info-circle"></i> Select a date range and click
                            <b>Scan</b> to discover available variables.</span>
                        </div>
                    </div>

                    <!-- CCA Sets (visible only for CCA) -->
                    <div class="d-none mt-3" id="ccaSetsGroup">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Set 1 (Predictors)</label>
                                <div class="d-flex flex-wrap gap-2" id="ccaSet1Checks"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Set 2 (Outcomes)</label>
                                <div class="d-flex flex-wrap gap-2" id="ccaSet2Checks"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-primary" id="runBtn" onclick="runAnalysis()">
                            <i class="bi bi-play-fill me-1"></i> Run Analysis
                        </button>
                        <div class="spinner-border spinner-border-sm text-primary d-none align-self-center" id="spinner"
                             role="status"></div>
                        <span class="text-muted small align-self-center d-none" id="spinnerText">Running R script...</span>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- ─── Error Banner ────────────────────────────────────────────── -->
    <div class="alert alert-danger d-none" id="errorBanner" role="alert"></div>

    <!-- ─── NA Report ───────────────────────────────────────────────── -->
    <div class="alert alert-info d-none" id="naReport" role="alert">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Missing Data Report:</strong> <span id="naReportText"></span>
    </div>

    <!-- ─── Results Section ─────────────────────────────────────────── -->
    <section id="resultsSection" class="d-none">

        <!-- Method badge -->
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="badge bg-primary fs-6" id="resultMethodBadge"></span>
            <span class="text-muted" id="resultMeta"></span>
        </div>

        <!-- PCA Results -->
        <div id="pcaResults" class="d-none">
            <div class="row g-4">
                <!-- Scree / Variance Table -->
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Eigenvalues &amp; Variance Explained</h6>
                            <table class="table table-sm table-hover" id="pcaTable">
                                <thead>
                                    <tr>
                                        <th>PC</th>
                                        <th>Eigenvalue</th>
                                        <th>Var %</th>
                                        <th>Cum %</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Scree Plot -->
                <div class="col-lg-7">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Scree Plot</h6>
                            <div id="screePlot" style="width:100%;height:320px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loadings Heatmap -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">Loadings Heatmap (first 5 PCs)</h6>
                    <div id="loadingsHeatmap" style="width:100%;height:400px;"></div>
                </div>
            </div>

            <!-- 3D Scatter of Scores -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">PCA Score Scatter (PC1 × PC2 × PC3)</h6>
                    <p class="text-muted small mb-2">Each dot is one day. Colour encodes PC3 value. Hover for details.</p>
                    <div id="pcaScatter3d" style="width:100%;height:500px;"></div>
                </div>
            </div>

            <!-- 2D Cluster Scatter -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">PC1 vs PC2 – Day Clusters</h6>
                    <p class="text-muted small mb-2">Colour represents approximate k-means cluster (k = 3 on PC1–PC3).</p>
                    <div id="pcaScatter2d" style="width:100%;height:420px;"></div>
                </div>
            </div>

            <!-- PCA Insights Block -->
            <div class="card shadow-sm border-0 mt-4 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Biostatistical Interpretation</h6>
                    <div id="pcaInsights" class="small"></div>
                </div>
            </div>
        </div>

        <!-- EFA Results -->
        <div id="efaResults" class="d-none">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Suitability Tests</h6>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <td>Bartlett χ²</td>
                                        <td id="efaBartlett"></td>
                                    </tr>
                                    <tr>
                                        <td>Bartlett p-value</td>
                                        <td id="efaBartlettP"></td>
                                    </tr>
                                    <tr>
                                        <td>KMO (Overall MSA)</td>
                                        <td id="efaKmo"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Factor Variance Explained</h6>
                            <div id="efaBarChart" style="width:100%;height:300px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">Factor Loadings Heatmap</h6>
                    <div id="efaLoadingsHeatmap" style="width:100%;height:400px;"></div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">Communalities</h6>
                    <table class="table table-sm table-hover" id="communalityTable">
                        <thead>
                            <tr>
                                <th>Variable</th>
                                <th>h² (Communality)</th>
                                <th>u² (Uniqueness)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <!-- EFA Insights Block -->
            <div class="card shadow-sm border-0 mt-4 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Biostatistical Interpretation</h6>
                    <div id="efaInsights" class="small"></div>
                </div>
            </div>
        </div>

        <!-- CCA Results -->
        <div id="ccaResults" class="d-none">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title">Canonical Correlations</h6>
                    <table class="table table-sm table-hover" id="ccaDimTable">
                        <thead>
                            <tr>
                                <th>Dimension</th>
                                <th>Canonical r</th>
                                <th>r²</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">X Coefficients (Set 1)</h6>
                            <div id="ccaXCoefPlot" style="width:100%;height:320px;"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Y Coefficients (Set 2)</h6>
                            <div id="ccaYCoefPlot" style="width:100%;height:320px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CCA Insights Block -->
            <div class="card shadow-sm border-0 mt-4 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Biostatistical Interpretation</h6>
                    <div id="ccaInsights" class="small"></div>
                </div>
            </div>
        </div>

        <!-- CLUSTER Results -->
        <div id="clusterResults" class="d-none">
            <div class="row g-4">
                <!-- Clustering Tendency & Quality -->
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Clustering Quality</h6>
                            <table class="table table-sm">
                                <tbody>
                                    <tr><td>Hopkins Statistic</td><td id="clHopkins"></td></tr>
                                    <tr><td>Clustering Tendency</td><td id="clTendency"></td></tr>
                                    <tr><td>K (clusters)</td><td id="clK"></td></tr>
                                    <tr><td>Silhouette Avg</td><td id="clSilhouette"></td></tr>
                                    <tr><td>Between SS / Total SS</td><td id="clBssRatio"></td></tr>
                                    <tr><td>Linkage Method</td><td id="clLinkage"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Elbow Plot -->
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Elbow Method (WCSS)</h6>
                            <div id="clElbowPlot" style="width:100%;height:300px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cluster Scatter -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">K-Means Cluster Scatter (PCA-projected)</h6>
                    <p class="text-muted small mb-2">Each dot is one day. Colours show cluster assignment. Data is projected to 2D via PCA for visualization.</p>
                    <div id="clScatter" style="width:100%;height:480px;"></div>
                </div>
            </div>

            <!-- Silhouette Plot -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">Silhouette Plot</h6>
                    <div id="clSilhouettePlot" style="width:100%;height:400px;"></div>
                </div>
            </div>

            <!-- Cluster Centers Table -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">Cluster Centers (scaled)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover" id="clCentersTable">
                            <thead><tr></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Cluster Insights Block -->
            <div class="card shadow-sm border-0 mt-4 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Biostatistical Interpretation</h6>
                    <div id="clusterInsights" class="small"></div>
                </div>
            </div>
        </div>

        <!-- REGRESSION Results -->
        <div id="regressionResults" class="d-none">
            <!-- Tautology warning (shown when R² ≥ 0.99) -->
            <div id="tautologyWarning" class="alert alert-danger d-none mb-3">
                <i class="bi bi-exclamation-octagon-fill me-2"></i>
                <strong>Tautological model detected (R² ≥ 0.99):</strong>
                <span id="tautologyWarningText">The near-perfect fit suggests the target variable is a mathematical
                function of the predictors. This is not a meaningful statistical model — it's an algebraic identity.
                Try removing component variables or choosing a different target.</span>
            </div>
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Model Summary</h6>
                            <table class="table table-sm">
                                <tbody>
                                    <tr><td>Target</td><td id="regTarget" class="fw-bold"></td></tr>
                                    <tr><td>R²</td><td id="regR2"></td></tr>
                                    <tr><td>Adjusted R²</td><td id="regAdjR2"></td></tr>
                                    <tr><td>F-statistic</td><td id="regF"></td></tr>
                                    <tr><td>F p-value</td><td id="regFP"></td></tr>
                                    <tr><td>Shapiro p</td><td id="regShapiro"></td></tr>
                                    <tr><td>Residuals Normal?</td><td id="regNormal"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Coefficient Significance</h6>
                            <div id="regCoefPlot" style="width:100%;height:320px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">Coefficients Table</h6>
                    <table class="table table-sm table-hover" id="regCoefTable">
                        <thead>
                            <tr><th>Variable</th><th>Estimate</th><th>Std Error</th><th>t</th><th>p</th><th>Sig</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Actual vs Fitted</h6>
                            <div id="regFittedPlot" style="width:100%;height:360px;"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Residual Distribution</h6>
                            <div id="regResidPlot" style="width:100%;height:360px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- REGRESSION Insights Block -->
            <div class="card shadow-sm border-0 mt-4 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Biostatistical Interpretation</h6>
                    <div id="regressionInsights" class="small"></div>
                </div>
            </div>
        </div>

        <!-- MDS Results -->
        <div id="mdsResults" class="d-none">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">MDS Quality</h6>
                            <table class="table table-sm">
                                <tbody>
                                    <tr><td>Dimensions</td><td id="mdsDimsResult"></td></tr>
                                    <tr><td>Goodness of Fit</td><td id="mdsGoF"></td></tr>
                                    <tr><td>Stress (Kruskal)</td><td id="mdsStress"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="card-title">Eigenvalue Scree</h6>
                            <div id="mdsScreePlot" style="width:100%;height:300px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <h6 class="card-title">MDS Configuration Map</h6>
                    <p class="text-muted small mb-2">Each point is one day. Similar days are close together. Hover for date.</p>
                    <div id="mdsScatter" style="width:100%;height:500px;"></div>
                </div>
            </div>

            <!-- MDS Insights Block -->
            <div class="card shadow-sm border-0 mt-4 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Biostatistical Interpretation</h6>
                    <div id="mdsInsights" class="small"></div>
                </div>
            </div>
        </div>

    </section>

    @section Scripts {
        <!-- Plotly.js for interactive charts -->
        <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
        <script>
            // ── Globals ──────────────────────────────────────────────────────
            // Density data returned by /api/DeepAnalytics/density
            let densityData = null;     // full DataDensityResult
            let availableVars = [];     // keys that passed the threshold

            // ── Method result cache ──────────────────────────────────────────
            // Stores { config: {...}, data: {...} } per method key
            const methodCache = {};

            // ── Variable Name Prettifier (must be before render functions) ───
            const varNameMap = {
                'steps': 'Daily Steps', 'goal_steps': 'Goal Steps',
                'total_calories': 'Total Calories', 'active_calories': 'Active Calories',
                'distance_meters': 'Distance (m)', 'sleep_score': 'Sleep Score',
                'total_sleep_secs': 'Total Sleep', 'deep_sleep_secs': 'Deep Sleep',
                'light_sleep_secs': 'Light Sleep', 'rem_sleep_secs': 'REM Sleep',
                'awake_secs': 'Awake Time', 'resting_hr': 'Resting Heart Rate',
                'bb_change': 'Body Battery Δ', 'avg_respiration': 'Avg Respiration',
                'lowest_spo2': 'Lowest SpO₂', 'activity_duration_secs': 'Activity Duration',
                'activity_distance_m': 'Activity Distance',
            };
            function pretty(v) { return varNameMap[v] || v.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()); }
            function insightList(items) {
                return '<ul class="mb-0 mt-2">' + items.map(i => `<li>${i}</li>`).join('') + '</ul>';
            }
            function insightSection(title, items) {
                if (!items || items.length === 0) return '';
                return `<div class="mb-3"><strong class="text-primary">${title}</strong>${insightList(items)}</div>`;
            }

            // ── Compositional variable groups ────────────────────────────────
            // When a target belongs to a group, its sibling components should
            // be excluded as predictors to avoid tautological regressions.
            const compositionalGroups = [
                {
                    parent: 'TotalSleep',
                    components: ['DeepSleep', 'LightSleep', 'RemSleep', 'AwakeSecs'],
                    reason: 'TotalSleep ≈ DeepSleep + LightSleep + RemSleep + AwakeSecs (mathematical identity)'
                },
                {
                    parent: 'TotalCalories',
                    components: ['ActiveCalories'],
                    reason: 'TotalCalories includes ActiveCalories (partial identity)'
                },
            ];

            /** Given a regression target, return { excluded: [...], reason: '...' } */
            function getCompositionalExclusions(target) {
                for (const g of compositionalGroups) {
                    if (g.parent === target) {
                        return { excluded: g.components, reason: g.reason };
                    }
                    if (g.components.includes(target)) {
                        return { excluded: [g.parent, ...g.components.filter(c => c !== target)],
                                 reason: `${target} is a component of ${g.parent} — including ${g.parent} or sibling components would create a tautological model` };
                    }
                }
                return { excluded: [], reason: '' };
            }

            // ── Variables to HIDE per method (statistically meaningless) ────
            const methodExcludedVars = {
                'PCA':        ['GoalSteps'],
                'EFA':        ['GoalSteps'],
                'CCA':        ['GoalSteps'],
                'CLUSTER':    ['GoalSteps'],
                'REGRESSION': ['GoalSteps'],
                'MDS':        ['GoalSteps'],
            };

            // ── Mutual exclusion: aggregate ↔ components ─────────────────────
            // Checking one side auto-unchecks the other to prevent redundancy
            const mutualExclusionGroups = [
                {
                    aggregate:  ['TotalSleep'],
                    components: ['DeepSleep', 'LightSleep', 'RemSleep', 'AwakeSecs'],
                    hint: 'Use either TotalSleep (aggregate) or its sleep-stage components, not both',
                },
                {
                    aggregate:  ['TotalCalories'],
                    components: ['ActiveCalories'],
                    hint: 'TotalCalories includes ActiveCalories — using both adds redundancy',
                },
            ];

            // ── Smart defaults per method ────────────────────────────────────
            // null = user configures manually; array = auto-check on first visit
            const methodDefaultVars = {
                'PCA':        ['Steps', 'ActiveCalories', 'Distance', 'SleepScore', 'DeepSleep', 'LightSleep', 'RemSleep', 'RestingHR', 'BodyBatteryChange', 'AvgRespiration', 'LowestSpO2'],
                'EFA':        ['Steps', 'ActiveCalories', 'Distance', 'SleepScore', 'DeepSleep', 'LightSleep', 'RemSleep', 'RestingHR', 'BodyBatteryChange', 'AvgRespiration', 'LowestSpO2'],
                'CCA':        null,
                'CLUSTER':    ['Steps', 'ActiveCalories', 'Distance', 'SleepScore', 'DeepSleep', 'LightSleep', 'RemSleep', 'RestingHR', 'BodyBatteryChange'],
                'REGRESSION': null,
                'MDS':        ['Steps', 'ActiveCalories', 'Distance', 'SleepScore', 'DeepSleep', 'LightSleep', 'RemSleep', 'RestingHR', 'BodyBatteryChange'],
            };

            const ccaDefaultSets = {
                set1: ['Steps', 'ActiveCalories', 'Distance'],
                set2: ['SleepScore', 'DeepSleep', 'LightSleep', 'RemSleep', 'RestingHR', 'BodyBatteryChange'],
            };

            // Default date range: last 90 days
            const today = new Date();
            const d90 = new Date(today); d90.setDate(d90.getDate() - 90);
            document.getElementById('endDate').value = today.toISOString().slice(0, 10);
            document.getElementById('startDate').value = d90.toISOString().slice(0, 10);

            // Auto-scan when dates change
            document.getElementById('startDate').addEventListener('change', () => scanDensity());
            document.getElementById('endDate').addEventListener('change', () => scanDensity());
            document.getElementById('densitySlider').addEventListener('change', () => {
            if (densityData) refilterFromCachedDensity();
            });

            // Kick off initial scan
            document.addEventListener('DOMContentLoaded', () => scanDensity());

            // ── Density scan ─────────────────────────────────────────────────
            async function scanDensity() {
            const spinner = document.getElementById('densitySpinner');
            const status = document.getElementById('densityStatus');
            const scanBtn = document.getElementById('scanBtn');
            spinner.classList.remove('d-none');
            scanBtn.disabled = true;
            status.textContent = 'Scanning...';

            const minDensity = parseInt(document.getElementById('densitySlider').value) / 100;

            try {
            const res = await fetch('/api/DeepAnalytics/density', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
            startDate: document.getElementById('startDate').value,
            endDate: document.getElementById('endDate').value,
            minDensity: minDensity,
            }),
            });
            densityData = await res.json();
            refilterFromCachedDensity();
            } catch (ex) {
            status.textContent = 'Scan failed: ' + ex.message;
            densityData = null;
            } finally {
            spinner.classList.add('d-none');
            scanBtn.disabled = false;
            }
            }

            function refilterFromCachedDensity() {
            if (!densityData || !densityData.variables) return;
            const minDensity = parseInt(document.getElementById('densitySlider').value) / 100;
            const status = document.getElementById('densityStatus');

            // Re-evaluate availability with current slider value
            for (const v of densityData.variables) {
            v.available = v.density >= minDensity;
            }

            availableVars = densityData.variables.filter(v => v.available).map(v => v.key);
            const unavailable = densityData.variables.filter(v => !v.available);

            status.textContent = `${availableVars.length} of ${densityData.variables.length} variables have ≥${Math.round(minDensity * 100)}% data (${densityData.totalDaysInRange} days)`;

            buildDensityCheckboxes('variableCheckboxes', densityData.variables, 'var_');
            buildDensityCheckboxes('ccaSet1Checks', densityData.variables, 'cca1_');
            buildDensityCheckboxes('ccaSet2Checks', densityData.variables, 'cca2_');

            // Apply method-specific variable visibility & defaults
            applyMethodVariableRules();

            // Refresh regression target if that method is active
            if (document.getElementById('methodSelect').value === 'REGRESSION') {
                populateRegressionTarget();
            }

            // Restore cached config if exists for current method
            const currentMethod = document.getElementById('methodSelect').value;
            if (methodCache[currentMethod]) {
                restoreMethodConfig(currentMethod, methodCache[currentMethod].config);
            }
            }

            // ── Build checkboxes with density badges ─────────────────────────
            function buildDensityCheckboxes(containerId, variables, prefix) {
            const c = document.getElementById(containerId);
            c.innerHTML = '';

            // Group by category
            const groups = {};
            for (const v of variables) {
            const g = v.group || 'Other';
            if (!groups[g]) groups[g] = [];
            groups[g].push(v);
            }

            for (const [group, vars] of Object.entries(groups)) {
            // Group label
            const groupLabel = document.createElement('div');
            groupLabel.className = 'w-100 mt-1 mb-0';
            groupLabel.innerHTML = `<small class="text-muted fw-bold text-uppercase" style="font-size:.7rem;letter-spacing:.05em">${group}</small>`;
            c.appendChild(groupLabel);

            const row = document.createElement('div');
            row.className = 'd-flex flex-wrap gap-2 mb-1';

            for (const v of vars) {
            const id = prefix + v.key;
            const pct = Math.round(v.density * 100);
            const disabled = !v.available;
            const badgeClass = v.available
            ? (pct >= 70 ? 'bg-success' : 'bg-warning text-dark')
            : 'bg-danger';

            const wrapper = document.createElement('div');
            wrapper.className = 'form-check form-check-inline' + (disabled ? ' opacity-50' : '');
            wrapper.dataset.var = v.key;
            wrapper.innerHTML = `
            <input class="form-check-input" type="checkbox" value="${v.key}" id="${id}"
            ${disabled ? 'disabled' : ''} ${v.available ? 'checked' : ''}>
            <label class="form-check-label small" for="${id}">
            ${v.key} <span class="badge ${badgeClass}" style="font-size:.65rem">${pct}%</span>
            </label>`;
            row.appendChild(wrapper);
            }
            c.appendChild(row);
            }
            }

            // ── Mutual exclusion handler ─────────────────────────────────────
            function handleMutualExclusion(containerId, changedVar, isChecked) {
                if (!isChecked) return;
                for (const group of mutualExclusionGroups) {
                    if (group.aggregate.includes(changedVar)) {
                        group.components.forEach(comp => {
                            const cb = document.querySelector(`#${containerId} input[value="${comp}"]`);
                            if (cb) cb.checked = false;
                        });
                    } else if (group.components.includes(changedVar)) {
                        group.aggregate.forEach(agg => {
                            const cb = document.querySelector(`#${containerId} input[value="${agg}"]`);
                            if (cb) cb.checked = false;
                        });
                    }
                }
            }

            // Delegated listeners for mutual exclusion on all checkbox containers
            ['variableCheckboxes', 'ccaSet1Checks', 'ccaSet2Checks'].forEach(cid => {
                document.getElementById(cid).addEventListener('change', function (e) {
                    if (e.target.type === 'checkbox') {
                        handleMutualExclusion(cid, e.target.value, e.target.checked);
                    }
                });
            });

            // ── Apply method-specific variable rules ─────────────────────────
            function applyMethodVariableRules(method) {
                if (!method) method = document.getElementById('methodSelect').value;
                const excluded = methodExcludedVars[method] || [];

                // Hide excluded variables in all checkbox containers
                ['variableCheckboxes', 'ccaSet1Checks', 'ccaSet2Checks'].forEach(cid => {
                    document.querySelectorAll(`#${cid} [data-var]`).forEach(wrapper => {
                        if (excluded.includes(wrapper.dataset.var)) {
                            wrapper.classList.add('d-none');
                            const cb = wrapper.querySelector('input');
                            if (cb) cb.checked = false;
                        } else {
                            wrapper.classList.remove('d-none');
                        }
                    });
                });

                // Apply smart defaults if no cache exists for this method
                if (!methodCache[method]) {
                    const defaults = methodDefaultVars[method];
                    if (defaults) {
                        document.querySelectorAll('#variableCheckboxes [data-var]').forEach(wrapper => {
                            const cb = wrapper.querySelector('input');
                            if (!cb || cb.disabled || wrapper.classList.contains('d-none')) return;
                            cb.checked = defaults.includes(cb.value);
                        });
                    }

                    // CCA set defaults
                    if (method === 'CCA') {
                        document.querySelectorAll('#ccaSet1Checks [data-var]').forEach(wrapper => {
                            const cb = wrapper.querySelector('input');
                            if (!cb || cb.disabled || wrapper.classList.contains('d-none')) return;
                            cb.checked = ccaDefaultSets.set1.includes(cb.value);
                        });
                        document.querySelectorAll('#ccaSet2Checks [data-var]').forEach(wrapper => {
                            const cb = wrapper.querySelector('input');
                            if (!cb || cb.disabled || wrapper.classList.contains('d-none')) return;
                            cb.checked = ccaDefaultSets.set2.includes(cb.value);
                        });
                        // Main checkboxes = union of both sets
                        const ccaAll = [...ccaDefaultSets.set1, ...ccaDefaultSets.set2];
                        document.querySelectorAll('#variableCheckboxes [data-var]').forEach(wrapper => {
                            const cb = wrapper.querySelector('input');
                            if (!cb || cb.disabled || wrapper.classList.contains('d-none')) return;
                            cb.checked = ccaAll.includes(cb.value);
                        });
                    }
                }
            }

            // ── Method toggle ────────────────────────────────────────────────
            document.getElementById('methodSelect').addEventListener('change', function () {
            const m = this.value;
            document.getElementById('efaFactorsGroup').classList.toggle('d-none', m !== 'EFA');
            document.getElementById('ccaSetsGroup').classList.toggle('d-none', m !== 'CCA');
            document.getElementById('clusterKGroup').classList.toggle('d-none', m !== 'CLUSTER');
            document.getElementById('linkageGroup').classList.toggle('d-none', m !== 'CLUSTER');
            document.getElementById('regressionTargetGroup').classList.toggle('d-none', m !== 'REGRESSION');
            document.getElementById('mdsDimsGroup').classList.toggle('d-none', m !== 'MDS');
            document.getElementById('compositionalWarning').classList.add('d-none');

            // Apply per-method variable visibility and smart defaults
            applyMethodVariableRules(m);

            // Populate regression target dropdown from visible checked variables
            if (m === 'REGRESSION') populateRegressionTarget();

            // ── Restore cached results or show defaults ──────────────
            const cached = methodCache[m];
            if (cached && cached.data) {
                // Restore method-specific config
                restoreMethodConfig(m, cached.config);
                // Re-render cached results
                renderResults(cached.data);
            } else {
                // No cache — hide results, show default config
                document.getElementById('resultsSection').classList.add('d-none');
                document.getElementById('naReport').classList.add('d-none');
                hideAllResultPanels();
            }
            });

            // ── Collect checked values (excludes hidden vars) ────────────────
            function getChecked(containerId) {
            return [...document.querySelectorAll(`#${containerId} [data-var]:not(.d-none) input:checked`)].map(c => c.value);
            }

            // ── Hide all result panels ───────────────────────────────────────
            function hideAllResultPanels() {
                ['pcaResults', 'efaResults', 'ccaResults', 'clusterResults', 'regressionResults', 'mdsResults']
                    .forEach(id => document.getElementById(id).classList.add('d-none'));
            }

            // ── Capture current method-specific config ──────────────────────
            function captureMethodConfig(method) {
                const cfg = {
                    variables: getChecked('variableCheckboxes'),
                    startDate: document.getElementById('startDate').value,
                    endDate: document.getElementById('endDate').value,
                };
                switch (method) {
                    case 'EFA':
                        cfg.nFactors = document.getElementById('nFactors').value;
                        break;
                    case 'CCA':
                        cfg.ccaSet1 = getChecked('ccaSet1Checks');
                        cfg.ccaSet2 = getChecked('ccaSet2Checks');
                        break;
                    case 'CLUSTER':
                        cfg.nClusters = document.getElementById('nClusters').value;
                        cfg.linkageMethod = document.getElementById('linkageMethod').value;
                        break;
                    case 'REGRESSION':
                        cfg.regressionTarget = document.getElementById('regressionTarget').value;
                        break;
                    case 'MDS':
                        cfg.mdsDims = document.getElementById('mdsDims').value;
                        break;
                }
                return cfg;
            }

            // ── Restore method-specific config from cache ───────────────────
            function restoreMethodConfig(method, cfg) {
                if (!cfg) return;
                // Restore variable checkboxes
                if (cfg.variables) {
                    document.querySelectorAll('#variableCheckboxes input[type=checkbox]').forEach(cb => {
                        cb.checked = cfg.variables.includes(cb.value);
                    });
                }
                switch (method) {
                    case 'EFA':
                        if (cfg.nFactors) document.getElementById('nFactors').value = cfg.nFactors;
                        break;
                    case 'CCA':
                        if (cfg.ccaSet1) {
                            document.querySelectorAll('#ccaSet1Checks input[type=checkbox]').forEach(cb => {
                                cb.checked = cfg.ccaSet1.includes(cb.value);
                            });
                        }
                        if (cfg.ccaSet2) {
                            document.querySelectorAll('#ccaSet2Checks input[type=checkbox]').forEach(cb => {
                                cb.checked = cfg.ccaSet2.includes(cb.value);
                            });
                        }
                        break;
                    case 'CLUSTER':
                        if (cfg.nClusters) document.getElementById('nClusters').value = cfg.nClusters;
                        if (cfg.linkageMethod) document.getElementById('linkageMethod').value = cfg.linkageMethod;
                        break;
                    case 'REGRESSION':
                        populateRegressionTarget();
                        if (cfg.regressionTarget) {
                            document.getElementById('regressionTarget').value = cfg.regressionTarget;
                            handleRegressionTargetChange();
                        }
                        break;
                    case 'MDS':
                        if (cfg.mdsDims) document.getElementById('mdsDims').value = cfg.mdsDims;
                        break;
                }
            }

            // ── Regression target change handler ────────────────────────────
            // Auto-exclude compositional variables and show warning
            document.getElementById('regressionTarget').addEventListener('change', handleRegressionTargetChange);

            function handleRegressionTargetChange() {
                const target = document.getElementById('regressionTarget').value;
                const warningEl = document.getElementById('compositionalWarning');
                const warningTextEl = document.getElementById('compositionalWarningText');
                const excludedVarsEl = document.getElementById('compositionalExcludedVars');

                if (!target) {
                    warningEl.classList.add('d-none');
                    return;
                }

                const { excluded, reason } = getCompositionalExclusions(target);
                if (excluded.length > 0) {
                    warningTextEl.textContent = reason;
                    excludedVarsEl.textContent = `Auto-excluded from predictors: ${excluded.join(', ')}`;
                    warningEl.classList.remove('d-none');
                    // Uncheck the excluded variables
                    document.querySelectorAll('#variableCheckboxes input[type=checkbox]').forEach(cb => {
                        if (excluded.includes(cb.value)) {
                            cb.checked = false;
                        }
                    });
                } else {
                    warningEl.classList.add('d-none');
                }
            }

            // ── Run ──────────────────────────────────────────────────────────
            async function runAnalysis() {
            const btn = document.getElementById('runBtn');
            const spinner = document.getElementById('spinner');
            const spinnerText = document.getElementById('spinnerText');
            const errorBanner = document.getElementById('errorBanner');

            btn.disabled = true;
            spinner.classList.remove('d-none');
            spinnerText.classList.remove('d-none');
            errorBanner.classList.add('d-none');
            document.getElementById('resultsSection').classList.add('d-none');
            document.getElementById('naReport').classList.add('d-none');

            const method = document.getElementById('methodSelect').value;
            let selectedVars = getChecked('variableCheckboxes');

            // For regression, enforce compositional exclusion and validate target
            if (method === 'REGRESSION') {
                const target = document.getElementById('regressionTarget').value;
                if (!target) {
                    errorBanner.textContent = 'Please select a regression target variable (Y).';
                    errorBanner.classList.remove('d-none');
                    btn.disabled = false;
                    spinner.classList.add('d-none');
                    spinnerText.classList.add('d-none');
                    return;
                }
                const { excluded } = getCompositionalExclusions(target);
                selectedVars = selectedVars.filter(v => !excluded.includes(v));
            }

            // Guard: need at least 2 variables for any multivariate method
            if (selectedVars.length < 2) {
            errorBanner.textContent = 'Select at least 2 variables for multivariate analysis.';
            errorBanner.classList.remove('d-none');
            btn.disabled = false;
            spinner.classList.add('d-none');
            spinnerText.classList.add('d-none');
            return;
            }

            const body = {
            startDate: document.getElementById('startDate').value,
            endDate: document.getElementById('endDate').value,
            method: method,
            variables: selectedVars,
            numberOfFactors: parseInt(document.getElementById('nFactors').value) || 5,
            ccaSet1: method === 'CCA' ? getChecked('ccaSet1Checks') : [],
            ccaSet2: method === 'CCA' ? getChecked('ccaSet2Checks') : [],
            numberOfClusters: parseInt(document.getElementById('nClusters').value) || 3,
            linkageMethod: document.getElementById('linkageMethod').value || 'complete',
            regressionTarget: method === 'REGRESSION' ? document.getElementById('regressionTarget').value : null,
            mdsDimensions: parseInt(document.getElementById('mdsDims').value) || 2,
            };

            try {
            const res = await fetch('/api/DeepAnalytics/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            });
            const data = await res.json();

            if (!res.ok || data.error) {
            errorBanner.textContent = data.error || `Server error (${res.status})`;
            errorBanner.classList.remove('d-none');
            return;
            }

            // Cache results + config for this method
            methodCache[method] = {
                config: captureMethodConfig(method),
                data: data,
            };

            renderResults(data);
            } catch (ex) {
            errorBanner.textContent = 'Request failed: ' + ex.message;
            errorBanner.classList.remove('d-none');
            } finally {
            btn.disabled = false;
            spinner.classList.add('d-none');
            spinnerText.classList.add('d-none');
            }
            }

            // ── Render dispatcher ────────────────────────────────────────────
            function renderResults(data) {
            document.getElementById('resultsSection').classList.remove('d-none');
            document.getElementById('resultMethodBadge').textContent = data.method;
            document.getElementById('resultMeta').textContent =
            `${data.observations} days × ${data.variableCount} variables`;

            // NA report
            if (data.naReport && data.naReport.naCellsBefore > 0) {
            const nr = data.naReport;
            document.getElementById('naReportText').textContent =
            `${nr.naCellsBefore} missing values found (${nr.rowsBefore} rows). ` +
            `After median imputation: ${nr.naCellsAfter} NAs remain, ${nr.rowsAfter} rows used. ` +
            `Columns: ${nr.columnsUsed.join(', ')}`;
            document.getElementById('naReport').classList.remove('d-none');
            }

            // Hide all result panels
            ['pcaResults', 'efaResults', 'ccaResults', 'clusterResults', 'regressionResults', 'mdsResults'].forEach(id =>
            document.getElementById(id).classList.add('d-none'));

            switch (data.method) {
            case 'PCA': renderPCA(data); break;
            case 'EFA': renderEFA(data); break;
            case 'CCA': renderCCA(data); break;
            case 'CLUSTER': renderCluster(data); break;
            case 'REGRESSION': renderRegression(data); break;
            case 'MDS': renderMDS(data); break;
            }
            }

            // ── Helper: Populate regression target dropdown ──────────────────
            function populateRegressionTarget() {
                const sel = document.getElementById('regressionTarget');
                const prev = sel.value;
                sel.innerHTML = '<option value="">— select target —</option>';

                // Build a set of variables that actually have data (from density scan)
                const varsWithData = new Set();
                if (densityData && densityData.variables) {
                    const minDensity = parseInt(document.getElementById('densitySlider').value) / 100;
                    for (const v of densityData.variables) {
                        if (v.density >= minDensity) varsWithData.add(v.key);
                    }
                }

                // Only show visible, checked variables that also have real data
                document.querySelectorAll('#variableCheckboxes [data-var]:not(.d-none)').forEach(wrapper => {
                    const cb = wrapper.querySelector('input');
                    if (!cb || !cb.checked) return;
                    // Skip if density data is loaded and this var has no data
                    if (varsWithData.size > 0 && !varsWithData.has(cb.value)) return;
                    sel.innerHTML += `<option value="${cb.value}">${cb.value}</option>`;
                });

                // Restore previous selection if still valid
                if (prev && sel.querySelector(`option[value="${prev}"]`)) {
                    sel.value = prev;
                }
            }

            // ══════════════════════════════════════════════════════════════════
            // PCA Rendering
            // ══════════════════════════════════════════════════════════════════
            function renderPCA(data) {
            document.getElementById('pcaResults').classList.remove('d-none');

            // Table
            const tbody = document.querySelector('#pcaTable tbody');
            tbody.innerHTML = '';
            for (const c of data.components) {
            const cls = c.eigenvalue >= 1 ? 'fw-bold' : '';
            tbody.innerHTML += `<tr class="${cls}">
            <td>${c.name}</td><td>${c.eigenvalue.toFixed(2)}</td>
            <td>${c.variancePct.toFixed(1)}%</td><td>${c.cumulativePct.toFixed(1)}%</td></tr>`;
            }

            // Scree plot
            const pcNames = data.components.map(c => c.name);
            const eigenvals = data.components.map(c => c.eigenvalue);
            const cumPct = data.components.map(c => c.cumulativePct);

            Plotly.newPlot('screePlot', [
            {
            x: pcNames, y: eigenvals, type: 'bar', name: 'Eigenvalue',
            marker: { color: 'rgba(55,128,191,0.7)' }
            },
            {
            x: pcNames, y: cumPct, type: 'scatter', mode: 'lines+markers',
            name: 'Cumulative %', yaxis: 'y2',
            line: { color: 'rgba(219,64,82,0.9)', width: 2 }
            },
            ], {
            yaxis: { title: 'Eigenvalue' },
            yaxis2: { title: 'Cumulative %', overlaying: 'y', side: 'right', range: [0, 105] },
            legend: { x: 0.7, y: 1.1, orientation: 'h' },
            margin: { t: 20, r: 60 },
            }, { responsive: true });

            // Loadings heatmap
            if (data.loadings && data.loadings.length > 0) {
            const vars = data.loadings.map(l => l.variable);
            const pcCols = Object.keys(data.loadings[0]).filter(k => k.startsWith('PC'));
            const maxPc = Math.min(pcCols.length, 5);
            const usePcs = pcCols.slice(0, maxPc);
            const z = data.loadings.map(l => usePcs.map(pc => l[pc] || 0));

            Plotly.newPlot('loadingsHeatmap', [{
            z: z, x: usePcs, y: vars, type: 'heatmap',
            colorscale: 'RdBu', zmid: 0,
            hovertemplate: '%{y} → %{x}: %{z:.3f}<extra></extra>',
            }], {
            margin: { l: 140, t: 20 },
            }, { responsive: true });
            }

            // 3D Scatter
            if (data.scores && data.scores.length > 0) {
            const pc1 = data.scores.map(s => s['PC1'] || 0);
            const pc2 = data.scores.map(s => s['PC2'] || 0);
            const pc3 = data.scores.map(s => s['PC3'] || 0);
            const dates = data.scores.map(s => s.date || `Day ${s.row_index}`);

            // Simple k-means (k=3) on PC1-PC3 for colouring
            const clusters = simpleKMeans(pc1, pc2, pc3, 3);
            const clusterColors = ['#636EFA', '#EF553B', '#00CC96'];

            Plotly.newPlot('pcaScatter3d', [{
            x: pc1, y: pc2, z: pc3,
            mode: 'markers', type: 'scatter3d',
            marker: { size: 4, color: clusters.map(c => clusterColors[c]), opacity: 0.75 },
            text: dates.map((d, i) => `${d}<br>Cluster ${clusters[i] + 1}`),
            hovertemplate: '%{text}<br>PC1=%{x:.2f}<br>PC2=%{y:.2f}<br>PC3=%{z:.2f}<extra></extra>',
            }], {
            scene: {
            xaxis: { title: 'PC1 (Recovery ↔ Stress)' },
            yaxis: { title: 'PC2 (High Intensity)' },
            zaxis: { title: 'PC3 (Step Volume ↔ Sport)' },
            },
            margin: { t: 20 },
            }, { responsive: true });

            // 2D scatter with cluster colours
            Plotly.newPlot('pcaScatter2d',
            [0, 1, 2].map(k => ({
            x: pc1.filter((_, i) => clusters[i] === k),
            y: pc2.filter((_, i) => clusters[i] === k),
            text: dates.filter((_, i) => clusters[i] === k),
            mode: 'markers', type: 'scatter', name: `Cluster ${k + 1}`,
            marker: { size: 7, color: clusterColors[k], opacity: 0.7 },
            hovertemplate: '%{text}<br>PC1=%{x:.2f}<br>PC2=%{y:.2f}<extra></extra>',
            })),
            {
            xaxis: { title: 'PC1 (Recovery ↔ Stress)' },
            yaxis: { title: 'PC2 (High Intensity)' },
            margin: { t: 20 },
            }, { responsive: true }
            );
            }

            // Generate insights
            generatePcaInsights(data);
            }

            // ══════════════════════════════════════════════════════════════════
            // EFA Rendering
            // ══════════════════════════════════════════════════════════════════
            function renderEFA(data) {
            document.getElementById('efaResults').classList.remove('d-none');

            document.getElementById('efaBartlett').textContent = data.bartlettChiSq?.toFixed(1) ?? '–';
            document.getElementById('efaBartlettP').textContent =
            data.bartlettPValue != null ? data.bartlettPValue.toExponential(2) : '–';
            document.getElementById('efaKmo').textContent = data.kmoOverall?.toFixed(3) ?? '–';

            // Bar chart of factor variance
            if (data.factors) {
            Plotly.newPlot('efaBarChart', [{
            x: data.factors.map(f => f.factor),
            y: data.factors.map(f => f.variancePct),
            type: 'bar',
            marker: { color: 'rgba(55,128,191,0.7)' },
            text: data.factors.map(f => f.variancePct.toFixed(1) + '%'),
            textposition: 'outside',
            }], {
            yaxis: { title: 'Variance Explained (%)' },
            margin: { t: 20 },
            }, { responsive: true });
            }

            // Loadings heatmap
            if (data.loadings && data.loadings.length > 0) {
            const vars = data.loadings.map(l => l.variable);
            const factCols = Object.keys(data.loadings[0]).filter(k => k.startsWith('PA') || k.startsWith('Factor'));
            const z = data.loadings.map(l => factCols.map(f => l[f] || 0));

            Plotly.newPlot('efaLoadingsHeatmap', [{
            z: z, x: factCols, y: vars, type: 'heatmap',
            colorscale: 'RdBu', zmid: 0,
            hovertemplate: '%{y} → %{x}: %{z:.3f}<extra></extra>',
            }], {
            margin: { l: 140, t: 20 },
            }, { responsive: true });
            }

            // Communality table
            if (data.communalities) {
            const tbody = document.querySelector('#communalityTable tbody');
            tbody.innerHTML = '';
            for (const c of data.communalities) {
            const cls = c.communality >= 0.5 ? '' : 'text-danger';
            tbody.innerHTML += `<tr>
            <td>${c.variable}</td>
            <td class="${cls}">${c.communality.toFixed(3)}</td>
            <td>${c.uniqueness.toFixed(3)}</td></tr>`;
            }
            }

            // Generate insights
            generateEfaInsights(data);
            }

            // ══════════════════════════════════════════════════════════════════
            // CCA Rendering
            // ══════════════════════════════════════════════════════════════════
            function renderCCA(data) {
            document.getElementById('ccaResults').classList.remove('d-none');

            const tbody = document.querySelector('#ccaDimTable tbody');
            tbody.innerHTML = '';
            if (data.dimensions) {
            for (const d of data.dimensions) {
            const cls = d.canonicalCorr >= 0.3 ? 'fw-bold' : '';
            tbody.innerHTML += `<tr class="${cls}">
            <td>${d.dimension}</td>
            <td>${d.canonicalCorr.toFixed(4)}</td>
            <td>${d.canonicalCorrSq.toFixed(4)}</td></tr>`;
            }
            }

            // Coefficient bar charts
            plotCoefficients('ccaXCoefPlot', data.xCoefficients, 'Set 1');
            plotCoefficients('ccaYCoefPlot', data.yCoefficients, 'Set 2');

            // Generate insights
            generateCcaInsights(data);
            }

            function plotCoefficients(divId, coefficients, label) {
            if (!coefficients || coefficients.length === 0) return;
            const vars = coefficients.map(c => c.variable);
            // Use first canonical variate column
            const cols = Object.keys(coefficients[0]).filter(k => k !== 'variable');
            const firstCol = cols[0] || 'V1';

            Plotly.newPlot(divId, [{
            y: vars, x: coefficients.map(c => c[firstCol] || 0),
            type: 'bar', orientation: 'h', name: label,
            marker: { color: 'rgba(55,128,191,0.7)' },
            }], {
            xaxis: { title: `Coefficient (${firstCol})` },
            margin: { l: 130, t: 20 },
            }, { responsive: true });
            }

            // ══════════════════════════════════════════════════════════════════
            // CLUSTER Rendering
            // ══════════════════════════════════════════════════════════════════
            function renderCluster(data) {
            document.getElementById('clusterResults').classList.remove('d-none');
            const cl = data.clustering;

            // Quality table
            document.getElementById('clHopkins').textContent = cl.hopkinsStatistic?.toFixed(4) ?? '–';
            document.getElementById('clTendency').innerHTML = cl.clusteringTendency
                ? '<span class="badge bg-success">Yes</span>'
                : '<span class="badge bg-warning text-dark">Weak</span>';
            document.getElementById('clK').textContent = cl.k;
            document.getElementById('clSilhouette').textContent = cl.silhouetteAvg?.toFixed(4) ?? '–';
            const bssRatio = cl.totalSS > 0 ? ((cl.betweenSS / cl.totalSS) * 100).toFixed(1) + '%' : '–';
            document.getElementById('clBssRatio').textContent = bssRatio;
            document.getElementById('clLinkage').textContent = cl.linkageMethod;

            // Elbow plot
            if (cl.elbowWcss) {
                Plotly.newPlot('clElbowPlot', [{
                    x: cl.elbowWcss.map((_, i) => i + 1),
                    y: cl.elbowWcss,
                    type: 'scatter', mode: 'lines+markers',
                    marker: { size: 8, color: 'rgba(55,128,191,0.8)' },
                    line: { width: 2 },
                }], {
                    xaxis: { title: 'Number of Clusters (K)', dtick: 1 },
                    yaxis: { title: 'Total Within-Cluster SS' },
                    margin: { t: 20 },
                    shapes: [{
                        type: 'line', x0: cl.k, x1: cl.k, y0: 0, y1: 1, yref: 'paper',
                        line: { color: 'red', width: 2, dash: 'dash' }
                    }],
                    annotations: [{
                        x: cl.k, y: cl.elbowWcss[cl.k - 1] || 0,
                        text: `K=${cl.k}`, showarrow: true, arrowhead: 2,
                        ax: 40, ay: -30, font: { color: 'red' }
                    }]
                }, { responsive: true });
            }

            // Cluster scatter: PCA-project the points into 2D for viz
            if (cl.points && cl.points.length > 0) {
                const skipCols = new Set(['date', 'km_cluster', 'hc_cluster', 'row_index']);
                const numCols = Object.keys(cl.points[0]).filter(k => !skipCols.has(k) && typeof cl.points[0][k] === 'number');
                const matrix = cl.points.map(p => numCols.map(c => p[c] || 0));
                const pca2d = simplePCA2D(matrix);

                const clusterColors = ['#636EFA', '#EF553B', '#00CC96', '#AB63FA', '#FFA15A',
                                        '#19D3F3', '#FF6692', '#B6E880', '#FF97FF', '#FECB52'];
                const clusters = cl.assignments || cl.points.map(p => p.km_cluster);
                const dates = cl.points.map(p => p.date || '');

                const traces = [];
                const uniqueK = [...new Set(clusters)].sort((a, b) => a - b);
                for (const k of uniqueK) {
                    const idx = clusters.map((c, i) => c === k ? i : -1).filter(i => i >= 0);
                    traces.push({
                        x: idx.map(i => pca2d[i][0]),
                        y: idx.map(i => pca2d[i][1]),
                        text: idx.map(i => dates[i] || `Day ${i + 1}`),
                        mode: 'markers', type: 'scatter',
                        name: `Cluster ${k}`,
                        marker: { size: 7, color: clusterColors[(k - 1) % clusterColors.length], opacity: 0.8 },
                        hovertemplate: '%{text}<br>PC1=%{x:.2f}<br>PC2=%{y:.2f}<extra></extra>',
                    });
                }
                Plotly.newPlot('clScatter', traces, {
                    xaxis: { title: 'PC1 (projected)' },
                    yaxis: { title: 'PC2 (projected)' },
                    margin: { t: 20 },
                }, { responsive: true });
            }

            // Silhouette plot
            if (cl.silhouettePerPoint && cl.silhouettePerPoint.length > 0) {
                const sorted = [...cl.silhouettePerPoint].sort((a, b) => {
                    if (a.cluster !== b.cluster) return a.cluster - b.cluster;
                    return b.sil_width - a.sil_width;
                });
                const clusterColors = ['#636EFA', '#EF553B', '#00CC96', '#AB63FA', '#FFA15A',
                                        '#19D3F3', '#FF6692', '#B6E880', '#FF97FF', '#FECB52'];
                Plotly.newPlot('clSilhouettePlot', [{
                    y: sorted.map((_, i) => i),
                    x: sorted.map(s => s.sil_width),
                    type: 'bar', orientation: 'h',
                    marker: { color: sorted.map(s => clusterColors[(s.cluster - 1) % clusterColors.length]) },
                    hovertemplate: 'Cluster %{customdata}<br>Silhouette: %{x:.3f}<extra></extra>',
                    customdata: sorted.map(s => s.cluster),
                }], {
                    xaxis: { title: 'Silhouette Width', range: [-0.5, 1] },
                    yaxis: { visible: false },
                    margin: { l: 30, t: 20 },
                    shapes: [{
                        type: 'line', x0: cl.silhouetteAvg, x1: cl.silhouetteAvg,
                        y0: 0, y1: 1, yref: 'paper',
                        line: { color: 'red', width: 2, dash: 'dash' }
                    }]
                }, { responsive: true });
            }

            // Cluster centers table
            if (cl.clusterCenters && cl.clusterCenters.length > 0) {
                const cols = Object.keys(cl.clusterCenters[0]).filter(k => k !== 'cluster');
                const thead = document.querySelector('#clCentersTable thead tr');
                thead.innerHTML = '<th>Cluster</th>' + cols.map(c => `<th>${c}</th>`).join('');
                const tbody = document.querySelector('#clCentersTable tbody');
                tbody.innerHTML = '';
                for (const center of cl.clusterCenters) {
                    tbody.innerHTML += `<tr><td class="fw-bold">${center.cluster}</td>`
                        + cols.map(c => `<td>${typeof center[c] === 'number' ? center[c].toFixed(3) : center[c]}</td>`).join('')
                        + '</tr>';
                }
            }

            // Generate insights
            generateClusterInsights(data);
            }

            // ══════════════════════════════════════════════════════════════════
            // REGRESSION Rendering
            // ══════════════════════════════════════════════════════════════════
            function renderRegression(data) {
            document.getElementById('regressionResults').classList.remove('d-none');
            const reg = data.regression;

            // Tautology detection: R² ≥ 0.99 is suspicious
            const tautologyEl = document.getElementById('tautologyWarning');
            if (reg.rSquared >= 0.99) {
                tautologyEl.classList.remove('d-none');
            } else {
                tautologyEl.classList.add('d-none');
            }

            document.getElementById('regTarget').textContent = reg.targetVariable;
            document.getElementById('regR2').textContent = reg.rSquared?.toFixed(4) ?? '–';
            document.getElementById('regAdjR2').textContent = reg.adjustedRSquared?.toFixed(4) ?? '–';
            document.getElementById('regF').textContent = reg.fStatistic?.toFixed(2) ?? '–';
            document.getElementById('regFP').textContent = reg.fPValue != null ? reg.fPValue.toExponential(3) : '–';
            document.getElementById('regShapiro').textContent = reg.shapiroPValue?.toFixed(4) ?? '–';
            document.getElementById('regNormal').innerHTML = reg.residualsNormal
                ? '<span class="badge bg-success">Yes (p > 0.05)</span>'
                : '<span class="badge bg-warning text-dark">No</span>';

            // Coefficient bar chart
            if (reg.coefficients) {
                const nonIntercept = reg.coefficients.filter(c => c.variable !== '(Intercept)');
                const colors = nonIntercept.map(c => c.pValue < 0.05 ? '#00CC96' : (c.pValue < 0.1 ? '#FFA15A' : '#EF553B'));
                Plotly.newPlot('regCoefPlot', [{
                    y: nonIntercept.map(c => c.variable),
                    x: nonIntercept.map(c => c.estimate),
                    type: 'bar', orientation: 'h',
                    marker: { color: colors },
                    text: nonIntercept.map(c => c.significance),
                    textposition: 'auto',
                    hovertemplate: '%{y}: β=%{x:.4f}<extra></extra>',
                }], {
                    xaxis: { title: 'Coefficient (β)' },
                    margin: { l: 130, t: 20 },
                }, { responsive: true });

                // Table
                const tbody = document.querySelector('#regCoefTable tbody');
                tbody.innerHTML = '';
                for (const c of reg.coefficients) {
                    const cls = c.pValue < 0.05 ? 'table-success' : (c.pValue < 0.1 ? 'table-warning' : '');
                    tbody.innerHTML += `<tr class="${cls}">
                        <td>${c.variable}</td>
                        <td>${c.estimate.toFixed(4)}</td>
                        <td>${c.stdError.toFixed(4)}</td>
                        <td>${c.tValue.toFixed(3)}</td>
                        <td>${c.pValue < 0.001 ? c.pValue.toExponential(2) : c.pValue.toFixed(4)}</td>
                        <td>${c.significance}</td></tr>`;
                }
            }

            // Actual vs Fitted
            if (reg.fittedValues && reg.residuals) {
                const actual = reg.fittedValues.map((f, i) => f + reg.residuals[i]);
                Plotly.newPlot('regFittedPlot', [
                    {
                        x: actual, y: reg.fittedValues,
                        mode: 'markers', type: 'scatter', name: 'Observations',
                        marker: { size: 6, color: '#636EFA', opacity: 0.6 },
                        hovertemplate: 'Actual: %{x:.2f}<br>Fitted: %{y:.2f}<extra></extra>',
                    },
                    {
                        x: [Math.min(...actual), Math.max(...actual)],
                        y: [Math.min(...actual), Math.max(...actual)],
                        mode: 'lines', type: 'scatter', name: 'Perfect fit',
                        line: { color: 'red', dash: 'dash', width: 1.5 },
                    }
                ], {
                    xaxis: { title: 'Actual' },
                    yaxis: { title: 'Fitted' },
                    margin: { t: 20 },
                }, { responsive: true });

                // Residual histogram
                Plotly.newPlot('regResidPlot', [{
                    x: reg.residuals, type: 'histogram',
                    marker: { color: 'rgba(55,128,191,0.6)' },
                    nbinsx: 25,
                }], {
                    xaxis: { title: 'Residual' },
                    yaxis: { title: 'Count' },
                    margin: { t: 20 },
                }, { responsive: true });
            }

            // Generate insights
            generateRegressionInsights(data);
            }

            // ══════════════════════════════════════════════════════════════════
            // MDS Rendering
            // ══════════════════════════════════════════════════════════════════
            function renderMDS(data) {
            document.getElementById('mdsResults').classList.remove('d-none');
            const mds = data.mds;

            document.getElementById('mdsDimsResult').textContent = mds.dimensions;
            document.getElementById('mdsGoF').textContent = (mds.goF * 100).toFixed(1) + '%';
            const stressLabel = mds.stress < 0.05 ? 'Excellent' : (mds.stress < 0.1 ? 'Good' : (mds.stress < 0.2 ? 'Fair' : 'Poor'));
            document.getElementById('mdsStress').textContent = mds.stress.toFixed(4) + ` (${stressLabel})`;

            // Eigenvalue scree
            if (mds.eigenvalues) {
                Plotly.newPlot('mdsScreePlot', [{
                    x: mds.eigenvalues.map((_, i) => i + 1),
                    y: mds.eigenvalues,
                    type: 'bar',
                    marker: { color: mds.eigenvalues.map((_, i) => i < mds.dimensions ? '#636EFA' : '#ddd') },
                }], {
                    xaxis: { title: 'Dimension', dtick: 1 },
                    yaxis: { title: 'Eigenvalue' },
                    margin: { t: 20 },
                }, { responsive: true });
            }

            // MDS scatter
            if (mds.points && mds.points.length > 0) {
                const dates = mds.points.map(p => p.date || `Day ${p.row_index}`);
                if (mds.dimensions >= 3 && mds.points[0]['Dim3'] !== undefined) {
                    Plotly.newPlot('mdsScatter', [{
                        x: mds.points.map(p => p['Dim1']),
                        y: mds.points.map(p => p['Dim2']),
                        z: mds.points.map(p => p['Dim3']),
                        text: dates,
                        mode: 'markers', type: 'scatter3d',
                        marker: { size: 4, color: mds.points.map(p => p['Dim1']), colorscale: 'Viridis', opacity: 0.7 },
                        hovertemplate: '%{text}<br>Dim1=%{x:.2f}<br>Dim2=%{y:.2f}<br>Dim3=%{z:.2f}<extra></extra>',
                    }], {
                        scene: { xaxis: { title: 'Dim 1' }, yaxis: { title: 'Dim 2' }, zaxis: { title: 'Dim 3' } },
                        margin: { t: 20 },
                    }, { responsive: true });
                } else {
                    Plotly.newPlot('mdsScatter', [{
                        x: mds.points.map(p => p['Dim1']),
                        y: mds.points.map(p => p['Dim2']),
                        text: dates,
                        mode: 'markers', type: 'scatter',
                        marker: { size: 7, color: '#636EFA', opacity: 0.6 },
                        hovertemplate: '%{text}<br>Dim1=%{x:.2f}<br>Dim2=%{y:.2f}<extra></extra>',
                    }], {
                        xaxis: { title: 'Dimension 1' }, yaxis: { title: 'Dimension 2' },
                        margin: { t: 20 },
                    }, { responsive: true });
                }
            }

            // Generate insights
            generateMdsInsights(data);
            }

            // ══════════════════════════════════════════════════════════════════
            // BIOSTATISTICAL INSIGHT ENGINE
            // Generates dynamic interpretation text based on R output values.
            // Follows the academic rigor of MSc Statistics Lab interpretation
            // patterns (Kaiser's rule, KMO ranges, Kruskal stress, etc.)
            // (varNameMap, pretty, insightList, insightSection are declared at
            //  the top of the script to avoid temporal dead-zone errors.)
            // ══════════════════════════════════════════════════════════════════

            // ══════════════════════════════════════════════════════════════════
            // PCA Insights
            // ══════════════════════════════════════════════════════════════════
            function generatePcaInsights(data) {
                const el = document.getElementById('pcaInsights');
                if (!data.components || data.components.length === 0) { el.innerHTML = '<em>Insufficient data for interpretation.</em>'; return; }

                const items = [];
                const retained = data.components.filter(c => c.eigenvalue >= 1);
                const totalCum = retained.length > 0 ? retained[retained.length - 1].cumulativePct : 0;

                // 1. Kaiser rule + scree assessment
                items.push(`<strong>Dimensionality:</strong> By Kaiser's criterion (eigenvalue > 1), <strong>${retained.length}</strong> of ${data.components.length} components should be retained, explaining <strong>${totalCum.toFixed(1)}%</strong> of total variance.`);

                if (totalCum >= 90) items.push('This is an <span class="badge bg-success">excellent</span> reduction — very little information is lost. Your health metrics can be effectively summarised by these few latent dimensions.');
                else if (totalCum >= 80) items.push('This is a <span class="badge bg-success">good</span> reduction. The retained components capture the dominant patterns in your daily health variability.');
                else if (totalCum >= 70) items.push('This is <span class="badge bg-warning text-dark">adequate</span> but some variability is unexplained. Consider retaining an additional component or adding more diverse variables.');
                else items.push('The retained components explain <span class="badge bg-danger">less than 70%</span> of your data — a substantial amount of daily health variation is being lost. This may indicate your metrics are highly heterogeneous or the dataset needs more observations.');

                // 2. First component interpretation
                const pc1 = data.components[0];
                items.push(`<strong>PC1</strong> alone captures ${pc1.variancePct.toFixed(1)}% of variance — this is the single most important axis of variation in your health data.`);

                // 3. Loading interpretation for PC1 + PC2
                if (data.loadings && data.loadings.length > 0) {
                    const pcCols = Object.keys(data.loadings[0]).filter(k => k.startsWith('PC'));
                    for (let pcIdx = 0; pcIdx < Math.min(2, pcCols.length); pcIdx++) {
                        const pc = pcCols[pcIdx];
                        const loadingSorted = data.loadings
                            .map(l => ({ var: l.variable, val: l[pc] || 0 }))
                            .sort((a, b) => Math.abs(b.val) - Math.abs(a.val));
                        const strong = loadingSorted.filter(l => Math.abs(l.val) >= 0.5);
                        if (strong.length > 0) {
                            const posVars = strong.filter(l => l.val > 0).map(l => pretty(l.var));
                            const negVars = strong.filter(l => l.val < 0).map(l => pretty(l.var));
                            let desc = `<strong>${pc}</strong> is primarily driven by `;
                            if (posVars.length > 0 && negVars.length > 0) {
                                desc += `<em>${posVars.join(', ')}</em> (positive) vs <em>${negVars.join(', ')}</em> (negative). This axis represents a <strong>trade-off</strong> — days high on one end tend to be low on the other.`;
                            } else {
                                desc += `<em>${strong.map(l => pretty(l.var)).join(', ')}</em> (|loading| ≥ 0.5). These variables move together as a coherent physiological dimension.`;
                            }
                            items.push(desc);
                        }
                    }
                }

                // 4. Athletic context
                items.push('<strong>Training implication:</strong> The PCA scatter groups similar days together. Days clustered tightly had similar physiological profiles; outliers may indicate unusual training loads, poor recovery, or rest days. Use this to identify your body\'s dominant training–recovery patterns.');

                el.innerHTML = insightSection('Dimensionality & Variance', items.slice(0, 3))
                             + insightSection('Component Interpretation', items.slice(3, items.length - 1))
                             + insightSection('Actionable Insight', [items[items.length - 1]]);
            }

            // ══════════════════════════════════════════════════════════════════
            // EFA Insights
            // ══════════════════════════════════════════════════════════════════
            function generateEfaInsights(data) {
                const el = document.getElementById('efaInsights');
                const items = [];

                // 1. Bartlett's test
                if (data.bartlettPValue != null) {
                    if (data.bartlettPValue < 0.05) {
                        items.push(`<strong>Bartlett's test:</strong> χ² = ${data.bartlettChiSq?.toFixed(1)}, p = ${data.bartlettPValue.toExponential(2)} — the correlation matrix differs significantly from the identity matrix (p < 0.05). <span class="badge bg-success">Factor analysis is meaningful.</span>`);
                    } else {
                        items.push(`<strong>Bartlett's test:</strong> p = ${data.bartlettPValue.toFixed(4)} — the correlation matrix does <strong>not</strong> differ significantly from identity. <span class="badge bg-danger">Factor analysis is not recommended</span> — your variables may be largely uncorrelated.`);
                    }
                }

                // 2. KMO
                if (data.kmoOverall != null) {
                    const kmo = data.kmoOverall;
                    let kmoLabel, kmoClass;
                    if (kmo >= 0.9)      { kmoLabel = 'Very Good'; kmoClass = 'bg-success'; }
                    else if (kmo >= 0.8) { kmoLabel = 'Good'; kmoClass = 'bg-success'; }
                    else if (kmo >= 0.7) { kmoLabel = 'Medium'; kmoClass = 'bg-info'; }
                    else if (kmo >= 0.6) { kmoLabel = 'Acceptable'; kmoClass = 'bg-warning text-dark'; }
                    else if (kmo >= 0.5) { kmoLabel = 'Poor'; kmoClass = 'bg-warning text-dark'; }
                    else                 { kmoLabel = 'Unsuitable'; kmoClass = 'bg-danger'; }
                    items.push(`<strong>KMO = ${kmo.toFixed(3)}</strong> — <span class="badge ${kmoClass}">${kmoLabel}</span> sampling adequacy for factor analysis. ${kmo < 0.5 ? 'The dataset is not suitable for factor analysis — variables lack sufficient shared variance.' : 'The shared variance among variables is sufficient to extract meaningful latent factors.'}`);
                }

                // 3. Factor interpretation
                if (data.factors && data.factors.length > 0) {
                    const totalVar = data.factors.reduce((s, f) => s + f.variancePct, 0);
                    items.push(`<strong>${data.factors.length} factors</strong> explain a cumulative <strong>${totalVar.toFixed(1)}%</strong> of variance. ${totalVar >= 80 ? 'This is a strong factor solution — most variation is captured.' : totalVar >= 60 ? 'This is an adequate solution, though some variance remains unexplained.' : 'This is a weak solution — consider adjusting the number of factors or including different variables.'}`);
                }

                // 4. Loading-based factor naming
                if (data.loadings && data.loadings.length > 0) {
                    const factCols = Object.keys(data.loadings[0]).filter(k => k !== 'variable');
                    for (let fi = 0; fi < Math.min(factCols.length, 4); fi++) {
                        const fc = factCols[fi];
                        const dominated = data.loadings
                            .map(l => ({ var: l.variable, val: l[fc] || 0 }))
                            .filter(l => Math.abs(l.val) >= 0.5)
                            .sort((a, b) => Math.abs(b.val) - Math.abs(a.val));
                        if (dominated.length > 0) {
                            const varNames = dominated.map(l => pretty(l.var)).join(', ');
                            // Domain-informed naming
                            const varKeys = dominated.map(l => l.var);
                            let factorLabel = '';
                            if (varKeys.some(v => /sleep|rem|deep|light|awake/i.test(v))) factorLabel = ' (Sleep Architecture)';
                            else if (varKeys.some(v => /steps|distance|calories/i.test(v))) factorLabel = ' (Physical Activity)';
                            else if (varKeys.some(v => /hr|resting|bb_change|battery|spo2|respiration/i.test(v))) factorLabel = ' (Recovery & Vitals)';
                            items.push(`<strong>${fc}${factorLabel}:</strong> loaded by ${varNames}. ${factorLabel ? 'This latent factor likely represents the ' + factorLabel.replace(/[() ]/g, '').toLowerCase() + ' dimension of your health.' : ''}`);
                        }
                    }
                }

                // 5. Communality check
                if (data.communalities) {
                    const poorVars = data.communalities.filter(c => c.communality < 0.3);
                    if (poorVars.length > 0) {
                        items.push(`<strong>Poorly explained variables:</strong> ${poorVars.map(c => pretty(c.variable) + ' (h²=' + c.communality.toFixed(2) + ')').join(', ')} have low communalities (< 0.3). These variables are not well represented by the factor model and may be measuring something independent.`);
                    }
                    const goodVars = data.communalities.filter(c => c.communality >= 0.7);
                    if (goodVars.length > 0) {
                        items.push(`<strong>Well-explained variables:</strong> ${goodVars.map(c => pretty(c.variable) + ' (h²=' + c.communality.toFixed(2) + ')').join(', ')} are strongly captured by the factor model.`);
                    }
                }

                el.innerHTML = insightSection('Suitability Assessment', items.slice(0, 2))
                             + insightSection('Factor Structure', items.filter((_, i) => i >= 2 && i < items.length - 1))
                             + (items.length > 2 ? insightSection('Variable Quality', items.slice(-2)) : '');
            }

            // ══════════════════════════════════════════════════════════════════
            // CCA Insights
            // ══════════════════════════════════════════════════════════════════
            function generateCcaInsights(data) {
                const el = document.getElementById('ccaInsights');
                const items = [];

                if (!data.dimensions || data.dimensions.length === 0) { el.innerHTML = '<em>No canonical dimensions to interpret.</em>'; return; }

                // 1. Set description
                const set1 = (data.set1Variables || []).map(pretty).join(', ');
                const set2 = (data.set2Variables || []).map(pretty).join(', ');
                items.push(`<strong>Variable sets:</strong> Set 1 (${set1}) vs Set 2 (${set2}). CCA finds the linear combinations of each set that are maximally correlated.`);

                // 2. Canonical correlations assessment
                const sigDims = data.dimensions.filter(d => d.canonicalCorr >= 0.3);
                const r1 = data.dimensions[0];
                items.push(`<strong>First canonical correlation:</strong> ρ₁ = ${r1.canonicalCorr.toFixed(4)} (ρ₁² = ${r1.canonicalCorrSq.toFixed(4)}). This means the best linear combination of Set 1 shares <strong>${(r1.canonicalCorrSq * 100).toFixed(1)}%</strong> of its variance with the best linear combination of Set 2.`);

                if (r1.canonicalCorr >= 0.7) {
                    items.push('<span class="badge bg-success">Strong</span> canonical correlation — there is a substantial linear relationship between the two variable sets. The physiological domains they represent are meaningfully coupled.');
                } else if (r1.canonicalCorr >= 0.4) {
                    items.push('<span class="badge bg-info">Moderate</span> canonical correlation — a meaningful but not dominant relationship exists between the variable sets. Some shared physiological processes link them.');
                } else {
                    items.push('<span class="badge bg-warning text-dark">Weak</span> canonical correlation — the two variable sets share little linear variance. They may represent largely independent physiological domains.');
                }

                // 3. Number of meaningful dimensions
                items.push(`<strong>${sigDims.length}</strong> of ${data.dimensions.length} canonical dimensions have ρ ≥ 0.3, suggesting ${sigDims.length} meaningful shared dimension${sigDims.length !== 1 ? 's' : ''} between the sets.`);

                // 4. Coefficient interpretation
                if (data.xCoefficients && data.xCoefficients.length > 0) {
                    const cols = Object.keys(data.xCoefficients[0]).filter(k => k !== 'variable');
                    if (cols.length > 0) {
                        const c1 = cols[0];
                        const topX = data.xCoefficients.map(c => ({ var: c.variable, val: Math.abs(c[c1] || 0) })).sort((a, b) => b.val - a.val);
                        const topY = (data.yCoefficients || []).map(c => ({ var: c.variable, val: Math.abs(c[c1] || 0) })).sort((a, b) => b.val - a.val);
                        if (topX.length > 0 && topY.length > 0) {
                            items.push(`<strong>First canonical variate:</strong> In Set 1, <em>${pretty(topX[0].var)}</em> has the strongest weight; in Set 2, <em>${pretty(topY[0].var)}</em> dominates. The primary cross-domain relationship is between these variables.`);
                        }
                    }
                }

                // 5. Athletic relevance
                items.push('<strong>Training implication:</strong> Strong canonical correlations between activity and recovery sets indicate your training load is affecting recovery metrics in a systematic, predictable way. Weak correlations may mean recovery is driven by factors not captured here (e.g., nutrition, stress).');

                el.innerHTML = insightSection('Cross-Domain Correlation', items.slice(0, 4))
                             + insightSection('Canonical Structure', items.slice(4, items.length - 1))
                             + insightSection('Actionable Insight', [items[items.length - 1]]);
            }

            // ══════════════════════════════════════════════════════════════════
            // Cluster Insights
            // ══════════════════════════════════════════════════════════════════
            function generateClusterInsights(data) {
                const el = document.getElementById('clusterInsights');
                if (!data.clustering) { el.innerHTML = '<em>No clustering data.</em>'; return; }
                const cl = data.clustering;
                const items = [];

                // 1. Hopkins test — clustering tendency
                if (cl.hopkinsStatistic != null) {
                    if (cl.clusteringTendency) {
                        items.push(`<strong>Hopkins statistic:</strong> H = ${cl.hopkinsStatistic.toFixed(4)} — <span class="badge bg-success">clustering tendency confirmed</span>. The data is not randomly distributed; natural groupings exist in your health patterns.`);
                    } else {
                        items.push(`<strong>Hopkins statistic:</strong> H = ${cl.hopkinsStatistic.toFixed(4)} — <span class="badge bg-warning text-dark">weak clustering tendency</span>. The data may be close to uniformly distributed. Clusters found may be artificial rather than natural groupings.`);
                    }
                }

                // 2. Silhouette quality
                const silAvg = cl.silhouetteAvg;
                if (silAvg != null) {
                    let silLabel, silClass;
                    if (silAvg >= 0.7)      { silLabel = 'strong structure'; silClass = 'bg-success'; }
                    else if (silAvg >= 0.5) { silLabel = 'reasonable structure'; silClass = 'bg-info'; }
                    else if (silAvg >= 0.25) { silLabel = 'weak structure'; silClass = 'bg-warning text-dark'; }
                    else                     { silLabel = 'no substantial structure'; silClass = 'bg-danger'; }
                    items.push(`<strong>Mean silhouette:</strong> ${silAvg.toFixed(4)} — <span class="badge ${silClass}">${silLabel}</span>. ${silAvg >= 0.5 ? 'The clusters are well-separated; your days fall into distinct physiological profiles.' : 'Cluster boundaries are fuzzy — some days could plausibly belong to more than one group.'}`);
                }

                // 3. BSS/TSS ratio
                if (cl.totalSS > 0) {
                    const bssRatio = (cl.betweenSS / cl.totalSS * 100);
                    items.push(`<strong>Between / Total SS:</strong> ${bssRatio.toFixed(1)}% — ${bssRatio >= 60 ? 'clusters explain most of the variance; the K-means partition is effective.' : bssRatio >= 40 ? 'moderate separation between clusters.' : 'clusters overlap substantially; consider a different K or different variables.'}`);
                }

                // 4. Cluster profiling via centroids
                if (cl.clusterCenters && cl.clusterCenters.length > 0) {
                    const featureCols = Object.keys(cl.clusterCenters[0]).filter(k => k !== 'cluster');
                    for (const center of cl.clusterCenters) {
                        const vals = featureCols.map(f => ({ var: f, val: typeof center[f] === 'number' ? center[f] : 0 }));
                        const hiVars = vals.filter(v => v.val > 0.5).sort((a, b) => b.val - a.val).slice(0, 3);
                        const loVars = vals.filter(v => v.val < -0.5).sort((a, b) => a.val - b.val).slice(0, 3);

                        let label = `<strong>Cluster ${center.cluster}`;
                        if (cl.clusterSizes) label += ` (${cl.clusterSizes[center.cluster - 1]} days)`;
                        label += ':</strong> ';

                        if (hiVars.length > 0) label += `High in ${hiVars.map(v => pretty(v.var)).join(', ')}. `;
                        if (loVars.length > 0) label += `Low in ${loVars.map(v => pretty(v.var)).join(', ')}. `;

                        // Domain profiling
                        const hiKeys = hiVars.map(v => v.var);
                        const loKeys = loVars.map(v => v.var);
                        if (hiKeys.some(k => /steps|distance|calories/i.test(k)) && loKeys.some(k => /sleep|rem|deep/i.test(k)))
                            label += 'Profile: <em>High-volume training days with reduced sleep.</em>';
                        else if (hiKeys.some(k => /sleep|rem|deep|bb_change/i.test(k)) && loKeys.some(k => /steps|distance|calories/i.test(k)))
                            label += 'Profile: <em>Recovery-focused rest days.</em>';
                        else if (hiKeys.some(k => /steps|distance/i.test(k)) && hiKeys.some(k => /sleep|bb_change/i.test(k)))
                            label += 'Profile: <em>Balanced days — adequate activity and good recovery.</em>';

                        items.push(label);
                    }
                }

                // 5. Elbow assessment
                if (cl.elbowWcss && cl.elbowWcss.length > 1) {
                    items.push(`<strong>Elbow analysis:</strong> The WCSS curve shows how cluster compactness improves with K. The chosen K = ${cl.k} should correspond to the "elbow" — beyond this point, adding clusters yields diminishing returns. ${cl.k === 3 ? 'K=3 often captures a natural rest / moderate / high-intensity split in training data.' : ''}`);
                }

                el.innerHTML = insightSection('Clustering Validity', items.slice(0, 3))
                             + insightSection('Cluster Profiles', items.filter((_, i) => i >= 3 && i < items.length - 1))
                             + (items.length > 3 ? insightSection('Model Selection', [items[items.length - 1]]) : '');
            }

            // ══════════════════════════════════════════════════════════════════
            // Regression Insights
            // ══════════════════════════════════════════════════════════════════
            function generateRegressionInsights(data) {
                const el = document.getElementById('regressionInsights');
                if (!data.regression) { el.innerHTML = '<em>No regression data.</em>'; return; }
                const reg = data.regression;
                const items = [];

                // 1. Model fit
                const r2 = reg.rSquared;
                let fitLabel, fitClass;
                if (r2 >= 0.99)      { fitLabel = 'Tautological'; fitClass = 'bg-danger'; }
                else if (r2 >= 0.8) { fitLabel = 'Strong'; fitClass = 'bg-success'; }
                else if (r2 >= 0.5) { fitLabel = 'Moderate'; fitClass = 'bg-info'; }
                else if (r2 >= 0.3) { fitLabel = 'Weak'; fitClass = 'bg-warning text-dark'; }
                else                 { fitLabel = 'Very Weak'; fitClass = 'bg-danger'; }

                items.push(`<strong>R² = ${r2.toFixed(4)}, Adjusted R² = ${reg.adjustedRSquared.toFixed(4)}</strong> — <span class="badge ${fitClass}">${fitLabel} fit</span>. The predictors collectively explain <strong>${(r2 * 100).toFixed(1)}%</strong> of the variance in ${pretty(reg.targetVariable)}.`);

                if (r2 >= 0.99) {
                    items.push('<span class="text-danger fw-bold">⚠ Near-perfect R² strongly suggests a tautological model</span> — the target is likely a mathematical function of the predictors (e.g., TotalSleep ≈ DeepSleep + LightSleep + RemSleep). This is an algebraic identity, not a meaningful statistical finding. Remove component variables or choose a different target.');
                } else {
                    const gap = r2 - reg.adjustedRSquared;
                    if (gap > 0.05) items.push(`The gap between R² and Adjusted R² (${gap.toFixed(3)}) suggests some overfitting — you may have too many predictors relative to observations. Consider removing insignificant variables.`);
                }

                // 2. F-test
                if (reg.fPValue != null) {
                    if (reg.fPValue < 0.05) {
                        items.push(`<strong>F-statistic = ${reg.fStatistic.toFixed(2)}, p = ${reg.fPValue < 0.001 ? reg.fPValue.toExponential(2) : reg.fPValue.toFixed(4)}</strong> — the overall model is <span class="badge bg-success">statistically significant</span>. At least one predictor has a non-zero relationship with ${pretty(reg.targetVariable)}.`);
                    } else {
                        items.push(`<strong>F-test p = ${reg.fPValue.toFixed(4)}</strong> — the model is <span class="badge bg-danger">not significant</span>. The predictors collectively do not explain ${pretty(reg.targetVariable)} better than a simple mean.`);
                    }
                }

                // 3. Coefficient interpretation
                if (reg.coefficients) {
                    const sigCoefs = reg.coefficients.filter(c => c.variable !== '(Intercept)' && c.pValue < 0.05);
                    const insigCoefs = reg.coefficients.filter(c => c.variable !== '(Intercept)' && c.pValue >= 0.05);

                    if (sigCoefs.length > 0) {
                        for (const c of sigCoefs.sort((a, b) => Math.abs(b.estimate) - Math.abs(a.estimate)).slice(0, 5)) {
                            const dir = c.estimate > 0 ? 'increases' : 'decreases';
                            items.push(`<strong>${pretty(c.variable)}</strong> (β = ${c.estimate.toFixed(4)}, p = ${c.pValue < 0.001 ? c.pValue.toExponential(2) : c.pValue.toFixed(4)}): Each unit increase in ${pretty(c.variable)} is associated with a ${Math.abs(c.estimate).toFixed(2)}-unit ${dir} in ${pretty(reg.targetVariable)}, holding other predictors constant.`);
                        }
                    }
                    if (insigCoefs.length > 0) {
                        items.push(`<strong>Non-significant predictors:</strong> ${insigCoefs.map(c => pretty(c.variable)).join(', ')} (p ≥ 0.05) — these do not contribute significantly to the model. Consider removing them for a more parsimonious fit.`);
                    }
                }

                // 4. Residual normality
                if (reg.shapiroPValue != null) {
                    if (reg.residualsNormal) {
                        items.push(`<strong>Shapiro-Wilk p = ${reg.shapiroPValue.toFixed(4)}</strong> — residuals are <span class="badge bg-success">approximately normal</span> (p > 0.05). The inference assumptions (confidence intervals, p-values) are reliable.`);
                    } else {
                        items.push(`<strong>Shapiro-Wilk p = ${reg.shapiroPValue.toFixed(4)}</strong> — residuals are <span class="badge bg-warning text-dark">not normal</span> (p ≤ 0.05). Coefficient p-values should be interpreted with caution. Consider a Box-Cox transformation or robust regression.`);
                    }
                }

                // 5. Athletic relevance
                if (r2 < 0.99 && reg.coefficients) {
                    const topSig = reg.coefficients.filter(c => c.variable !== '(Intercept)' && c.pValue < 0.05).sort((a, b) => Math.abs(b.estimate) - Math.abs(a.estimate))[0];
                    if (topSig) {
                        items.push(`<strong>Training implication:</strong> ${pretty(topSig.variable)} is the strongest predictor of ${pretty(reg.targetVariable)}. ${topSig.estimate > 0 ? 'Increasing' : 'Decreasing'} it tends to ${topSig.estimate > 0 ? 'improve' : 'reduce'} your ${pretty(reg.targetVariable)}. This relationship is independent of the other variables in the model.`);
                    }
                }

                el.innerHTML = insightSection('Model Assessment', items.slice(0, 3))
                             + insightSection('Key Predictors', items.filter((_, i) => i >= 3 && i < items.length - 2))
                             + insightSection('Diagnostic & Actionable', items.slice(-2));
            }

            // ══════════════════════════════════════════════════════════════════
            // MDS Insights
            // ══════════════════════════════════════════════════════════════════
            function generateMdsInsights(data) {
                const el = document.getElementById('mdsInsights');
                if (!data.mds) { el.innerHTML = '<em>No MDS data.</em>'; return; }
                const mds = data.mds;
                const items = [];

                // 1. Stress interpretation (Kruskal)
                let stressLabel, stressClass;
                if (mds.stress <= 0.025)      { stressLabel = 'Perfect'; stressClass = 'bg-success'; }
                else if (mds.stress <= 0.05) { stressLabel = 'Excellent'; stressClass = 'bg-success'; }
                else if (mds.stress <= 0.1)  { stressLabel = 'Good'; stressClass = 'bg-info'; }
                else if (mds.stress <= 0.2)  { stressLabel = 'Fair'; stressClass = 'bg-warning text-dark'; }
                else                          { stressLabel = 'Poor'; stressClass = 'bg-danger'; }

                items.push(`<strong>Kruskal stress = ${mds.stress.toFixed(4)}</strong> — <span class="badge ${stressClass}">${stressLabel}</span> fit. ${mds.stress <= 0.1 ? 'The low-dimensional map faithfully preserves the between-day distances from the original high-dimensional health data.' : mds.stress <= 0.2 ? 'The map is a reasonable approximation of the real distances, but some distortion exists.' : 'Substantial distortion — the 2D/3D projection is not reliably representing true day-to-day similarity. Consider using more dimensions.'}`);

                // 2. Goodness of Fit
                const gofPct = (mds.goF * 100).toFixed(1);
                items.push(`<strong>Goodness of Fit = ${gofPct}%</strong> — ${mds.goF >= 0.8 ? 'the retained dimensions capture most of the distance information. The map is trustworthy.' : mds.goF >= 0.6 ? 'adequate representation, though some distance relationships are lost in the projection.' : 'substantial information loss in the dimensional reduction. Interpret spatial relationships with caution.'}`);

                // 3. Eigenvalue decay
                if (mds.eigenvalues && mds.eigenvalues.length > 0) {
                    const posEig = mds.eigenvalues.filter(e => e > 0);
                    const totalEig = posEig.reduce((s, e) => s + e, 0);
                    const dimExplained = posEig.slice(0, mds.dimensions).reduce((s, e) => s + e, 0) / totalEig * 100;
                    items.push(`<strong>Eigenvalue concentration:</strong> The first ${mds.dimensions} dimensions capture ${dimExplained.toFixed(1)}% of the positive eigenvalue mass. ${dimExplained >= 80 ? 'Excellent — the chosen dimensionality is sufficient.' : 'Consider adding a dimension for better reconstruction fidelity.'}`);

                    const negCount = mds.eigenvalues.filter(e => e < 0).length;
                    if (negCount > 0) {
                        items.push(`<strong>Negative eigenvalues detected (${negCount}):</strong> The distance matrix is not perfectly Euclidean. This is common with health data that mixes different scales (seconds, steps, heart rate). The classical MDS solution remains valid but these dimensions are discarded.`);
                    }
                }

                // 4. Map interpretation
                items.push('<strong>Reading the map:</strong> Each point represents one day. Days close together had <em>similar</em> overall health profiles; distant days were physiologically different. Look for: (1) tight clusters of similar day-types, (2) outlier days far from the main mass — these may be unusually intense training days or illness/rest days, (3) temporal patterns — do recent days cluster differently from older ones?');

                // 5. Athletic context
                items.push('<strong>Training implication:</strong> If your recent days are drifting away from your historical cluster, your training load or recovery pattern may be changing. A tight cluster means consistency; a scattered pattern suggests high day-to-day variability in your health metrics.');

                el.innerHTML = insightSection('Reconstruction Quality', items.slice(0, 3))
                             + insightSection('Dimensional Assessment', items.slice(3, items.length - 1))
                             + insightSection('Actionable Insight', [items[items.length - 1]]);
            }

            // ══════════════════════════════════════════════════════════════════
            // Simple PCA 2D projection for cluster scatter visualization
            // ══════════════════════════════════════════════════════════════════
            function simplePCA2D(matrix) {
                const n = matrix.length;
                const p = matrix[0].length;
                const means = Array(p).fill(0);
                for (const row of matrix) row.forEach((v, j) => means[j] += v);
                means.forEach((_, j) => means[j] /= n);
                const centered = matrix.map(row => row.map((v, j) => v - means[j]));
                const cov = Array.from({ length: p }, () => Array(p).fill(0));
                for (const row of centered) {
                    for (let i = 0; i < p; i++)
                        for (let j = 0; j < p; j++)
                            cov[i][j] += row[i] * row[j];
                }
                cov.forEach(r => r.forEach((_, j, a) => a[j] /= (n - 1)));
                function powerIteration(mat) {
                    let v = Array(p).fill(0).map(() => Math.random());
                    for (let iter = 0; iter < 100; iter++) {
                        let nv = Array(p).fill(0);
                        for (let i = 0; i < p; i++)
                            for (let j = 0; j < p; j++)
                                nv[i] += mat[i][j] * v[j];
                        const norm = Math.sqrt(nv.reduce((s, x) => s + x * x, 0));
                        v = nv.map(x => x / (norm || 1));
                    }
                    const eigenvalue = v.reduce((s, vi, i) => {
                        let row = 0;
                        for (let j = 0; j < p; j++) row += mat[i][j] * v[j];
                        return s + vi * row;
                    }, 0);
                    return { vec: v, val: eigenvalue };
                }
                const e1 = powerIteration(cov);
                const cov2 = cov.map((row, i) => row.map((val, j) => val - e1.val * e1.vec[i] * e1.vec[j]));
                const e2 = powerIteration(cov2);
                return centered.map(row => [
                    row.reduce((s, v, j) => s + v * e1.vec[j], 0),
                    row.reduce((s, v, j) => s + v * e2.vec[j], 0),
                ]);
            }

            // ══════════════════════════════════════════════════════════════════
            // Simple k-means for client-side cluster colouring (k=3, 20 iters)
            // ══════════════════════════════════════════════════════════════════
            function simpleKMeans(x, y, z, k) {
            const n = x.length;
            // Random init
            let centroids = [];
            const used = new Set();
            while (centroids.length < k) {
            const idx = Math.floor(Math.random() * n);
            if (!used.has(idx)) {
            used.add(idx);
            centroids.push([x[idx], y[idx], z[idx]]);
            }
            }

            let labels = new Array(n).fill(0);
            for (let iter = 0; iter < 20; iter++) {
            // Assign
            for (let i = 0; i < n; i++) {
            let minDist = Infinity, best = 0;
            for (let c = 0; c < k; c++) {
            const d = (x[i] - centroids[c][0]) ** 2 +
            (y[i] - centroids[c][1]) ** 2 +
            (z[i] - centroids[c][2]) ** 2;
            if (d < minDist) { minDist = d; best = c; }
            }
            labels[i] = best;
            }
            // Update centroids
            for (let c = 0; c < k; c++) {
            let sx = 0, sy = 0, sz = 0, cnt = 0;
            for (let i = 0; i < n; i++) {
            if (labels[i] === c) { sx += x[i]; sy += y[i]; sz += z[i]; cnt++; }
            }
            if (cnt > 0) centroids[c] = [sx / cnt, sy / cnt, sz / cnt];
            }
            }
            return labels;
            }
        </script>
    }
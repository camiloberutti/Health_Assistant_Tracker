@page
@using System
@using System.Globalization
@using System.Text.Json
@model GarminTempApi.Pages.Activities.IndexModel
@{
    Layout = "_Layout";
    var serializerOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);

    double GetTotalDistanceKm(IEnumerable<GarminTempApi.Pages.Activities.IndexModel.ActivityRow> activities)
    {
        if (activities is null)
        {
            return 0;
        }

        return activities.Sum(a => a.DistanceMeters) / 1000d;
    }
}

<section class="activity-hero mb-4">
    <div class="activity-hero-card shadow-sm">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
            <div>
                <h1 class="display-6 mb-1">Activities</h1>
                <p class="text-muted mb-0">Filter and explore your latest training sessions.</p>
            </div>
            <div class="activity-stat-badges d-flex flex-wrap gap-3">
                <div class="stat-card">
                    <div class="label">Total sessions</div>
                    <div class="value">@Model.Activities.Count.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="label">Mileage (last 200)</div>
                    <div class="value">@GetTotalDistanceKm(Model.Activities).ToString("0.0") km</div>
                </div>
                <div class="stat-card">
                    <div class="label">Last activity</div>
                    <div class="value">@Model.LatestActivityDateDisplay</div>
                </div>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

<div class="activity-layout">
    <aside class="activity-filters card shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h5 mb-0">Filters</h2>
                <a class="btn btn-sm btn-outline-secondary" asp-page="Index">Reset</a>
            </div>
            <form id="activityFilters" method="get" class="vstack gap-3">
                <div>
                    <label class="form-label" for="filterStart">Start date</label>
                    <input id="filterStart" name="StartDate" value="@(Model.StartDate?.ToString("dd MMM yy", CultureInfo.InvariantCulture) ?? string.Empty)" class="form-control"
                        type="text" inputmode="numeric" autocomplete="off" placeholder="dd mmm yy" />
                </div>
                <div>
                    <label class="form-label" for="filterEnd">End date</label>
                    <input id="filterEnd" name="EndDate" value="@(Model.EndDate?.ToString("dd MMM yy", CultureInfo.InvariantCulture) ?? string.Empty)" class="form-control"
                        type="text" inputmode="numeric" autocomplete="off" placeholder="dd mmm yy" />
                </div>
                <div>
                    <label class="form-label" for="filterType">Activity type</label>
                    <select id="filterType" name="ActivityType" class="form-select">
                        <option value="">All types</option>
                        @foreach (var type in Model.ActivityTypes)
                        {
                            <option value="@type.Value" @(string.Equals(Model.ActivityType, type.Value, StringComparison.OrdinalIgnoreCase) ?
                                                              "selected" : null)>@type.Label</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100">Apply filters</button>
            </form>
        </div>
    </aside>

    <section class="activity-table card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <h2 class="h5 mb-0">Workout history</h2>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge trend-distance"><i class="bi bi-shoe-prints me-1"></i>Distance trend</span>
                    <span class="badge trend-duration"><i class="bi bi-stopwatch me-1"></i>Time trend</span>
                    <span class="text-muted small">Click a row for details</span>
                </div>
            </div>
            <div class="table-responsive rounded-3">
                <table id="activitiesTable" class="table table-hover align-middle mb-0" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Name</th>
                            <th>Sport</th>
                            <th>Distance</th>
                            <th>Duration</th>
                            <th>Pace / Speed</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<style>
    .activity-hero-card {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(30, 64, 175, 0.07));
        border: 1px solid rgba(59, 130, 246, 0.15);
        border-radius: 1.5rem;
        padding: 1.75rem;
    }

    .activity-stat-badges .stat-card {
        background: rgba(15, 23, 42, 0.12);
        border-radius: 1rem;
        padding: 0.85rem 1.1rem;
        min-width: 140px;
    }

    .activity-stat-badges .label {
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgba(15, 23, 42, 0.6);
    }

    .activity-stat-badges .value {
        font-weight: 600;
        font-size: 1.25rem;
        color: #0f172a;
    }

    .activity-layout {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    }

    .activity-filters {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1.25rem;
    }

    .activity-table {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1.25rem;
    }

    .activity-table thead {
        background: rgba(15, 23, 42, 0.05);
    }

    .activity-table thead th {
        border: 0;
        color: rgba(15, 23, 42, 0.6);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.75rem;
    }

    .activity-table tbody tr {
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .activity-table tbody tr:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
    }

    .trend-distance {
        background: rgba(59, 130, 246, 0.15);
        color: #1d4ed8;
    }

    .trend-duration {
        background: rgba(244, 114, 182, 0.16);
        color: #be185d;
    }

    @@media (max-width: 1200px) {
        .activity-layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .activity-filters {
            order: 2;
        }
    }

    @@media (max-width: 576px) {
        .activity-hero-card {
            padding: 1.35rem;
            border-radius: 1.25rem;
        }

        .activity-stat-badges {
            width: 100%;
            justify-content: space-between;
        }

        .activity-stat-badges .stat-card {
            flex: 1 1 45%;
        }
    }
</style>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

<script>
    (function () {
        const activities = @Html.Raw(JsonSerializer.Serialize(Model.Activities, serializerOptions));
        const shortMonths = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];

        function formatShortDate(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) {
                return '';
            }
            return date.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: '2-digit'
            }).replace(/,/g, '');
        }

        function parseShortDate(value) {
            if (!value) {
                return null;
            }
            const parts = value.trim().split(/\s+/);
            if (parts.length !== 3) {
                return null;
            }

            const day = Number.parseInt(parts[0], 10);
            const monthIndex = shortMonths.indexOf(parts[1].toLowerCase());
            let year = Number.parseInt(parts[2], 10);

            if (!Number.isFinite(day) || day <= 0 || monthIndex < 0 || !Number.isFinite(year)) {
                return null;
            }

            if (year < 100) {
                year += 2000;
            }

            const utcDate = new Date(Date.UTC(year, monthIndex, day));
            if (Number.isNaN(utcDate.getTime())) {
                return null;
            }

            return new Date(utcDate.getUTCFullYear(), utcDate.getUTCMonth(), utcDate.getUTCDate());
        }

        function computeEffortMetric(row) {
            const sport = (row.sport || '').toLowerCase();
            const distanceMeters = row.distanceMeters || 0;
            const durationSeconds = row.durationSeconds || 0;

            if (distanceMeters <= 0 || durationSeconds <= 0) {
                return '–';
            }

            const distanceKm = distanceMeters / 1000;

            const toPace = (secondsPerUnit, suffix) => {
                const minutes = Math.floor(secondsPerUnit / 60);
                const seconds = Math.round(secondsPerUnit % 60);
                return `${minutes}:${seconds.toString().padStart(2, '0')} ${suffix}`;
            };

            if (sport.includes('run') || sport.includes('trail') || sport.includes('walk')) {
                const secondsPerKm = durationSeconds / distanceKm;
                return toPace(secondsPerKm, '/km');
            }

            if (sport.includes('swim')) {
                const perHundredMeters = durationSeconds / (distanceMeters / 100);
                return toPace(perHundredMeters, '/100m');
            }

            if (sport.includes('bike') || sport.includes('ride') || sport.includes('cycle')) {
                const hours = durationSeconds / 3600;
                const speed = hours > 0 ? distanceKm / hours : 0;
                return `${speed.toFixed(1)} km/h`;
            }

            return '–';
        }

        const table = $('#activitiesTable').DataTable({
            data: activities,
            responsive: true,
            order: [[0, 'desc']],
            pageLength: 25,
            columns: [
                {
                    data: 'startTime',
                    render: function (data, type) {
                        if (type === 'sort' || type === 'type') {
                            return data;
                        }
                        return formatShortDate(data);
                    }
                },
                {
                    data: 'activityName',
                    render: function (data) {
                        return `<span class="activity-name" role="button" tabindex="0">${data}</span>`;
                    }
                },
                { data: 'sportDisplay' },
                {
                    data: 'distanceMeters',
                    render: function (meters) {
                        if (!meters || Number.isNaN(meters)) {
                            return '0.00';
                        }
                        return (meters / 1000).toFixed(2);
                    }
                },
                {
                    data: 'duration',
                    render: function (value) {
                        return value ?? '';
                    }
                },
                {
                    data: null,
                    render: function (row) {
                        return computeEffortMetric(row);
                    }
                }
            ]
        });

        function applyFilters() {
            const startValue = $('#filterStart').val();
            const endValue = $('#filterEnd').val();
            const typeValue = $('#filterType').val();

            $.fn.dataTable.ext.search = [];

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                const rowData = table.row(dataIndex).data();
                if (!rowData) {
                    return true;
                }

                const startTime = new Date(rowData.startTime);
                if (Number.isNaN(startTime.getTime())) {
                    return true;
                }

                const startFilter = parseShortDate(startValue);
                const endFilter = parseShortDate(endValue);

                if (startFilter && startTime < startFilter) {
                    return false;
                }

                if (endFilter) {
                    const endBoundary = new Date(endFilter.getFullYear(), endFilter.getMonth(), endFilter.getDate(), 23, 59, 59, 999);
                    if (startTime > endBoundary) {
                        return false;
                    }
                }

                if (typeValue && rowData.sport !== typeValue) {
                    return false;
                }

                return true;
            });

            table.draw();
        }

        applyFilters();

        $('#activityFilters').on('submit', function (evt) {
            evt.preventDefault();
            applyFilters();
        });

        $('#filterStart, #filterEnd, #filterType').on('change', function () {
            applyFilters();
        });

        $('#activitiesTable tbody').on('click', 'tr', function () {
            const data = table.row(this).data();
            if (!data) {
                return;
            }
            window.location.href = `/Activities/Details/${encodeURIComponent(data.activityId)}`;
        });

        $('#activitiesTable tbody').on('keypress', 'span.activity-name', function (evt) {
            if (evt.key === 'Enter') {
                const row = table.row($(this).closest('tr')).data();
                window.location.href = `/Activities/Details/${encodeURIComponent(row.activityId)}`;
            }
        });
    })();
</script>
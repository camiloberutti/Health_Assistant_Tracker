@page
@using System
@using System.Text.Json
@model GarminTempApi.Pages.Activities.IndexModel
@{
    Layout = "_Layout";
    var serializerOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<h2>Activities</h2>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

<form id="activityFilters" method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label" for="filterStart">Start date</label>
        <input id="filterStart" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control"
            type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="filterEnd">End date</label>
        <input id="filterEnd" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control"
            type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="filterType">Activity type</label>
        <select id="filterType" name="ActivityType" class="form-select">
            <option value="">All types</option>
            @foreach (var type in Model.ActivityTypes)
            {
                <option value="@type" @(string.Equals(Model.ActivityType, type, StringComparison.OrdinalIgnoreCase) ?
                                                      "selected" : null)>@type</option>
            }
        </select>
    </div>
    <div class="col-md-3 align-self-end text-md-end d-flex flex-row justify-content-md-end gap-2">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Reset</a>
    </div>
</form>

<div class="alert alert-light border rounded-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
        <span class="badge bg-primary-subtle text-primary-emphasis fw-semibold">Tip</span>
        <span class="text-muted">Click any activity row to open the detailed view with route map and interactive
            charts.</span>
    </div>
</div>

<div class="table-responsive">
    <table id="activitiesTable" class="table table-striped table-hover align-middle" style="width:100%;">
        <thead>
            <tr>
                <th>Date</th>
                <th>Name</th>
                <th>Sport</th>
                <th>Distance (km)</th>
                <th>Duration</th>
                <th>Pace / Speed</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

<script>
    (function () {
        const activities = @Html.Raw(JsonSerializer.Serialize(Model.Activities, serializerOptions));

        const table = $('#activitiesTable').DataTable({
            data: activities,
            responsive: true,
            order: [[0, 'desc']],
            pageLength: 25,
            columns: [
                {
                    data: 'startTime',
                    render: function (data) {
                        const date = new Date(data);
                        return date.toLocaleDateString();
                    }
                },
                {
                    data: 'activityName',
                    render: function (data) {
                        return `<span class="activity-name" role="button" tabindex="0">${data}</span>`;
                    }
                },
                { data: 'sport' },
                {
                    data: 'distanceMeters',
                    render: function (meters) {
                        if (!meters || Number.isNaN(meters)) {
                            return '0.00';
                        }
                        return (meters / 1000).toFixed(2);
                    }
                },
                {
                    data: 'duration',
                    render: function (value) {
                        return value ?? '';
                    }
                },
                {
                    data: null,
                    render: function (row) {
                        return computeEffortMetric(row);
                    }
                }
            ]
        });

        function computeEffortMetric(row) {
            const sport = (row.sport || '').toLowerCase();
            const distanceMeters = row.distanceMeters || 0;
            const durationSeconds = row.durationSeconds || 0;

            if (distanceMeters <= 0 || durationSeconds <= 0) {
                return '–';
            }

            const distanceKm = distanceMeters / 1000;

            const toPace = (secondsPerUnit, suffix) => {
                const minutes = Math.floor(secondsPerUnit / 60);
                const seconds = Math.round(secondsPerUnit % 60);
                return `${minutes}:${seconds.toString().padStart(2, '0')} ${suffix}`;
            };

            if (sport.includes('run') || sport.includes('trail') || sport.includes('walk')) {
                const secondsPerKm = durationSeconds / distanceKm;
                return toPace(secondsPerKm, '/km');
            }

            if (sport.includes('swim')) {
                const perHundredMeters = durationSeconds / (distanceMeters / 100);
                return toPace(perHundredMeters, '/100m');
            }

            if (sport.includes('bike') || sport.includes('ride') || sport.includes('cycle')) {
                const hours = durationSeconds / 3600;
                const speed = hours > 0 ? distanceKm / hours : 0;
                return `${speed.toFixed(1)} km/h`;
            }

            return '–';
        }

        function applyFilters() {
            const startValue = $('#filterStart').val();
            const endValue = $('#filterEnd').val();
            const typeValue = $('#filterType').val();

            $.fn.dataTable.ext.search = [];

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                const rowData = table.row(dataIndex).data();
                if (!rowData) {
                    return true;
                }

                const startTime = new Date(rowData.startTime);

                if (startValue) {
                    const startDate = new Date(startValue + 'T00:00:00');
                    if (startTime < startDate) {
                        return false;
                    }
                }

                if (endValue) {
                    const endDate = new Date(endValue + 'T23:59:59');
                    if (startTime > endDate) {
                        return false;
                    }
                }

                if (typeValue && rowData.sport !== typeValue) {
                    return false;
                }

                return true;
            });

            table.draw();
        }

        applyFilters();

        $('#activityFilters').on('submit', function (evt) {
            evt.preventDefault();
            applyFilters();
        });

        $('#filterStart, #filterEnd, #filterType').on('change', function () {
            applyFilters();
        });

        $('#activitiesTable tbody').on('click', 'tr', function () {
            const data = table.row(this).data();
            if (!data) {
                return;
            }
            window.location.href = `/Activities/Details/${encodeURIComponent(data.activityId)}`;
        });

        $('#activitiesTable tbody').on('keypress', 'span.activity-name', function (evt) {
            if (evt.key === 'Enter') {
                const row = table.row($(this).closest('tr')).data();
                window.location.href = `/Activities/Details/${encodeURIComponent(row.activityId)}`;
            }
        });
    })();
</script>
@page "{id}"
@using System
@using System.Text.Json
@model GarminTempApi.Pages.Activities.DetailsModel
@{
    Layout = "_Layout";
    var activity = Model.Activity!;
    var serializerOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha384-EdYikZ6irMIXja+6JGZve56kNjEcNWef39/C4R2tQeM+c/2yZfybp/BPZt6bYp0v" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<script>
    (function () {
        const trackPoints = @Html.Raw(JsonSerializer.Serialize(Model.TrackPoints.Select(p => new
            {
                timestamp = p.Timestamp,
                latitude = p.Latitude,
                longitude = p.Longitude,
                heartRate = p.HeartRate,
                altitude = p.Altitude
            }), serializerOptions));

        if (!Array.isArray(trackPoints) || trackPoints.length === 0) {
            return;
        }

        const coordinatePairs = trackPoints
            .filter(p => typeof p.latitude === 'number' && typeof p.longitude === 'number')
            .map(p => [p.latitude, p.longitude]);

        if (coordinatePairs.length > 0) {
            const map = L.map('activityMap');
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const polyline = L.polyline(coordinatePairs, { color: '#0d6efd', weight: 4, opacity: 0.8 }).addTo(map);
            map.fitBounds(polyline.getBounds(), { padding: [20, 20] });

            L.circleMarker(coordinatePairs[0], { color: '#198754', radius: 6 }).addTo(map).bindPopup('Start');
            L.circleMarker(coordinatePairs[coordinatePairs.length - 1], { color: '#dc3545', radius: 6 }).addTo(map).bindPopup('Finish');
        }
        else {
            document.getElementById('activityMap').innerHTML = '<p class="text-muted m-3">No GPS coordinates available.</p>';
        }

        const heartSamples = trackPoints.filter(p => typeof p.heartRate === 'number');
        if (heartSamples.length > 0) {
            new Chart(document.getElementById('chartHeartRate'), {
                type: 'line',
                data: {
                    labels: heartSamples.map(p => new Date(p.timestamp).toLocaleTimeString()),
                    datasets: [{
                        label: 'Heart Rate (bpm)',
                        data: heartSamples.map(p => p.heartRate),
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220,53,69,0.15)',
                        pointRadius: 0,
                        tension: 0.25
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { title: { display: true, text: 'Time' } },
                        y: { title: { display: true, text: 'bpm' } }
                    }
                }
            });
        }
        else {
            document.getElementById('chartHeartRate').parentElement.innerHTML = '<p class="text-muted mb-0">No heart rate samples available.</p>';
        }

        const altitudeSamples = trackPoints.filter(p => typeof p.altitude === 'number');
        if (altitudeSamples.length > 0) {
            new Chart(document.getElementById('chartAltitude'), {
                type: 'line',
                data: {
                    labels: altitudeSamples.map(p => new Date(p.timestamp).toLocaleTimeString()),
                    datasets: [{
                        label: 'Altitude (m)',
                        data: altitudeSamples.map(p => p.altitude),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13,110,253,0.1)',
                        pointRadius: 0,
                        tension: 0.25
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { title: { display: true, text: 'Time' } },
                        y: { title: { display: true, text: 'Meters' } }
                    }
                }
            });
        }
        else {
            document.getElementById('chartAltitude').parentElement.innerHTML = '<p class="text-muted mb-0">No altitude samples available.</p>';
        }
    })();
</script>

<h2>@activity.Name</h2>
<p class="text-muted">Source: @activity.Source · External Id: @activity.ExternalId</p>
@if (Model.Detail?.FetchedAtUtc is DateTime fetchedAtUtc)
{
    <p class="text-muted">Detail fetched @fetchedAtUtc.ToLocalTime().ToString("f")</p>
}

<style>
    #activityMap {
        height: 400px;
        border-radius: 0.5rem;
        border: 1px solid #dee2e6;
        margin-bottom: 2rem;
    }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha384-ZZ1xkZs8AjtKoa6HgMHqmpYyqn1nVbWcv16O3MHuvb6jVWeItPxX2VINqb0BoBP5" crossorigin="" />

<dl class="row">
    <dt class="col-sm-3">Start Time</dt>
    <dd class="col-sm-9">@activity.StartTime.ToLocalTime().ToString("f")</dd>

    <dt class="col-sm-3">Duration</dt>
    <dd class="col-sm-9">@activity.Duration.ToString(@"hh\:mm\:ss")</dd>

    <dt class="col-sm-3">Distance</dt>
    <dd class="col-sm-9">@(activity.DistanceMeters / 1000.0).ToString("0.00") km</dd>

    <dt class="col-sm-3">Activity Type</dt>
    <dd class="col-sm-9">@activity.ActivityType</dd>
</dl>

@if (Model.DetailErrors.Count > 0)
{
    <div class="alert alert-warning">
        <h5 class="alert-heading mb-2">Garmin detail warnings</h5>
        <ul class="mb-0">
            @foreach (var warning in Model.DetailErrors)
            {
                <li><strong>@warning.Key</strong>: @warning.Value</li>
            }
        </ul>
    </div>
}

@if (Model.SummaryMetrics.Count > 0)
{
    <h3 class="mt-4">Garmin Summary</h3>
    <div class="row g-3 mb-4">
        @foreach (var metric in Model.SummaryMetrics)
        {
            <div class="col-sm-6 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body py-3">
                        <p class="text-muted text-uppercase small mb-1">@metric.Label</p>
                        <strong class="fs-5">@metric.Value</strong>
                    </div>
                </div>
            </div>
        }
    </div>
}

<a class="btn btn-outline-secondary mb-4" asp-page="Index">Back to list</a>

@if (Model.TrackPoints.Count == 0)
{
    <div class="alert alert-secondary">No track points stored for this activity.</div>
}
else
{
    <div id="activityMap"></div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Heart Rate</h5>
                    <canvas id="chartHeartRate" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Altitude</h5>
                    <canvas id="chartAltitude" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <h3>Track Points <small class="text-muted">(showing first @Model.TrackPoints.Count)</small></h3>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Heart Rate</th>
                    <th>Altitude</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var point in Model.TrackPoints)
                {
                    <tr>
                        <td>@point.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@point.Latitude.ToString("0.000000")</td>
                        <td>@point.Longitude.ToString("0.000000")</td>
                        <td>@(point.HeartRate?.ToString("0") ?? "–")</td>
                        <td>@(point.Altitude?.ToString("0.0") ?? "–")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.JsonBlocks.Count > 0)
{
    <h3 class="mt-5">Garmin Raw Payload</h3>
    @foreach (var block in Model.JsonBlocks)
    {
        <details class="mb-3">
            <summary class="fw-semibold">@block.Title</summary>
            <pre class="bg-light border rounded p-3 small mb-0">@block.Json</pre>
        </details>
    }
}
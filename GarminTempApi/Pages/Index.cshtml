@page
@model GarminTempApi.Pages.IndexModel
@using GarminTempApi.Services
@using System
@using System.Globalization
@{
    Layout = "_Layout";
    var status = Model.Status;
    string FormatDate(DateTime? value)
    {
    return value is null ? "--" : value.Value.ToLocalTime().ToString("dd MMM yy", CultureInfo.InvariantCulture);
    }
    string FormatDateTime(DateTime? value)
    {
    return value is null ? "--" : value.Value.ToLocalTime().ToString("dd MMM yy HH:mm", CultureInfo.InvariantCulture);
    }
    string FormatDateOnly(DateOnly? value)
    {
        if (value is null)
        {
            return "--";
        }

        var asDateTime = value.Value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Unspecified);
    return asDateTime.ToString("dddd, dd MMM yy", CultureInfo.InvariantCulture);
    }
}

<div class="py-5 text-center">
    <h1>Welcome to App Garmin</h1>
    <p class="lead">Quick access to your activities, sleep and steps. Use the nav to go to a page.</p>
    <p><a class="btn btn-primary" href="/Activities">View Activities</a></p>
</div>

@if (Model.Summary?.Cards?.Count > 0)
{
    <section class="mb-5">
        <div class="d-flex align-items-baseline justify-content-between mb-3 flex-wrap gap-2">
            <h2 class="h4 mb-0">Daily Highlights</h2>
            <div class="text-muted small d-flex flex-wrap gap-2">
                @if (Model.Summary.LatestDataDate is not null)
                {
                    <span>Data through @FormatDateOnly(Model.Summary.LatestDataDate)</span>
                }
                <span>Updated @FormatDateTime(Model.Summary.GeneratedUtc)</span>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var card in Model.Summary.Cards)
            {
                <div class="col">
                    <a class="dashboard-card-link" href="@card.DestinationUrl">
                        <article class="card dashboard-card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column gap-3">
                                <div class="d-flex align-items-start justify-content-between gap-3">
                                    <div>
                                        <div class="text-uppercase small text-muted">@card.Title</div>
                                        <div class="fs-2 fw-semibold">@card.PrimaryValue</div>
                                        @if (!string.IsNullOrWhiteSpace(card.PrimaryCaption))
                                        {
                                            <div class="text-muted small">@card.PrimaryCaption</div>
                                        }
                                    </div>
                                    <span class="dashboard-card-accent @card.AccentCss">
                                        @if (string.Equals(card.IconCss, "icon-steps", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <svg class="icon-steps" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                <path d="M4.75 13.75V11.5c0-1.8 1.45-3.25 3.25-3.25h1.15c.63 0 1.22-.3 1.59-.82l1.34-1.85a2 2 0 011.63-.83h1.25c.77 0 1.49.37 1.94.99l1.12 1.57a3.5 3.5 0 001.86 1.29l2.34.64c.88.24 1.53 1.04 1.53 1.95V14a3.5 3.5 0 01-3.5 3.5H6.75a2 2 0 01-2-2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M5.5 16.5H17.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M9.5 11.5h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <i class="@card.IconCss"></i>
                                        }
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(card.Subtitle))
                                {
                                    <div class="text-muted small">@card.Subtitle</div>
                                }
                                @if (card.Stats?.Count > 0)
                                {
                                    <ul class="list-unstyled mb-0 small text-muted dashboard-card-stats">
                                        @foreach (var stat in card.Stats)
                                        {
                                            <li><span class="fw-semibold text-body">@stat.Value</span> &middot; @stat.Label</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>
    </section>
}
else
{
    <div class="alert alert-info">Sync your Garmin data to unlock dashboard highlights.</div>
}

@if (status is not null)
{
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="mb-0">Data Readiness</h5>
                        <span class="badge @(status.IsReady ? "bg-success" : "bg-warning text-dark")">@(status.IsReady ? "Ready" : "Needs attention")</span>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="data-ready-switch" disabled @(status.IsReady ? "checked" : null)>
                        <label class="form-check-label fw-semibold" for="data-ready-switch">All datasets loaded</label>
                    </div>

                    <p class="text-muted small mb-4">
                        @(status.IsReady
                            ? "Activities, sleep, and steps are available."
                            : $"Waiting on {(status.MissingComponents.Count == 0 ? "datasets" : string.Join(", ", status.MissingComponents))} to finish syncing.")
                    </p>

                    <div class="vstack gap-3">
                        <div class="d-flex align-items-start gap-3">
                            <input class="form-check-input mt-1" type="checkbox" id="activities-ready" disabled @(status.HasActivities ? "checked" : null)>
                            <div>
                                <label class="form-check-label fw-semibold" for="activities-ready">Activities</label>
                                <div class="text-muted small">Entries: @status.ActivityCount.ToString("N0") &middot; Latest: @FormatDateTime(status.LatestActivityStart)</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3">
                            <input class="form-check-input mt-1" type="checkbox" id="sleep-ready" disabled @(status.HasSleepSummaries ? "checked" : null)>
                            <div>
                                <label class="form-check-label fw-semibold" for="sleep-ready">Sleep summaries</label>
                                <div class="text-muted small">Nights: @status.SleepSummaryCount.ToString("N0") &middot; Latest: @FormatDate(status.LatestSleepDate)</div>
                                <div class="text-muted small">Detailed segments: @status.SleepDetailCount.ToString("N0")</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3">
                            <input class="form-check-input mt-1" type="checkbox" id="steps-ready" disabled @(status.HasStepSummaries ? "checked" : null)>
                            <div>
                                <label class="form-check-label fw-semibold" for="steps-ready">Step summaries</label>
                                <div class="text-muted small">Days: @status.StepSummaryCount.ToString("N0") &middot; Latest: @FormatDate(status.LatestStepDate)</div>
                            </div>
                        </div>
                    </div>

                    <div class="text-muted small mt-4">Status generated @FormatDateTime(status.GeneratedUtc).</div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .dashboard-card-link {
        text-decoration: none;
        color: inherit;
    }

    .dashboard-card {
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(33, 37, 41, 0.12);
    }

    .dashboard-card-accent {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .dashboard-card-accent .icon-steps {
        width: 1.5rem;
        height: 1.5rem;
    }

    .dashboard-card-stats li + li {
        margin-top: 0.35rem;
    }

    .accent-steps {
        background: rgba(13, 110, 253, 0.12);
        color: #0d6efd;
    }

    .accent-sleep {
        background: rgba(111, 66, 193, 0.12);
        color: #6f42c1;
    }

    .accent-activity {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
    }
</style>

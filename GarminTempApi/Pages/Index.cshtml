@page
@model GarminTempApi.Pages.IndexModel
@using GarminTempApi.Services
@using System
@using System.Globalization
@using System.Linq
@{
    Layout = "_Layout";
    string FormatDateTime(DateTime? value)
    {
        return value is null ? "--" : value.Value.ToLocalTime().ToString("dd MMM yy HH:mm", CultureInfo.InvariantCulture);
    }
    string FormatDateOnly(DateOnly? value)
    {
        if (value is null)
        {
            return "--";
        }

        var asDateTime = value.Value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Unspecified);
        return asDateTime.ToString("dddd, dd MMM yy", CultureInfo.InvariantCulture);
    }
}

<div class="pt-3 pb-2">
    <h1 class="h3 fw-bold mb-0">Dashboard</h1>
    <p class="text-muted mb-0">Your daily health &amp; performance briefing</p>
</div>

<section class="mb-4">
    <div class="card shadow-sm border-0 insights-card">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span
                    class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary"
                    style="width: 2rem; height: 2rem;">
                    <i class="bi bi-lightbulb"></i>
                </span>
                <h5 class="card-title mb-0 fs-6">AI Daily Briefing</h5>
                <button class="btn btn-sm btn-outline-secondary ms-auto" id="refreshRecommendation" title="Refresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div id="dailyRecommendation">
                <div class="d-flex align-items-center gap-2 text-muted">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    <span>Coach is analyzing your training data, sleep, and calendar...</span>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.Summary?.Cards?.Count > 0)
{
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
            <div>
                <h2 class="display-6 mb-0 fw-bold text-primary">Your Day</h2>
                @if (Model.Summary.LatestDataDate is not null)
                {
                    <span class="text-muted">@FormatDateOnly(Model.Summary.LatestDataDate)</span>
                }
            </div>
            <div class="text-end">
                <span class="badge bg-light text-dark border">Updated @FormatDateTime(Model.Summary.GeneratedUtc)</span>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var card in Model.Summary.Cards)
            {
                <div class="col">
                    <a class="dashboard-card-link" href="@card.DestinationUrl">
                        <article class="card dashboard-card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column gap-3">
                                <div class="d-flex align-items-start justify-content-between gap-3">
                                    <div>
                                        <div class="text-uppercase small text-muted">@card.Title</div>
                                        <div class="fs-2 fw-semibold">@card.PrimaryValue</div>
                                        @if (!string.IsNullOrWhiteSpace(card.PrimaryCaption))
                                        {
                                            <div class="text-muted small">@card.PrimaryCaption</div>
                                        }
                                    </div>
                                    <span class="dashboard-card-accent @card.AccentCss">
                                        @if (string.Equals(card.IconCss, "icon-steps", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <svg class="icon-steps" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                <path
                                                d="M4.75 13.75V11.5c0-1.8 1.45-3.25 3.25-3.25h1.15c.63 0 1.22-.3 1.59-.82l1.34-1.85a2 2 0 011.63-.83h1.25c.77 0 1.49.37 1.94.99l1.12 1.57a3.5 3.5 0 001.86 1.29l2.34.64c.88.24 1.53 1.04 1.53 1.95V14a3.5 3.5 0 01-3.5 3.5H6.75a2 2 0 01-2-2Z"
                                                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                                stroke-linejoin="round" />
                                                <path d="M5.5 16.5H17.5" fill="none" stroke="currentColor" stroke-width="1.6"
                                                      stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M9.5 11.5h3" fill="none" stroke="currentColor" stroke-width="1.6"
                                                      stroke-linecap="round" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <i class="@card.IconCss"></i>
                                        }
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(card.Subtitle))
                                {
                                    <div class="text-muted small">@card.Subtitle</div>
                                }
                                @if (card.Stats?.Count > 0)
                                {
                                    <ul class="list-unstyled mb-0 small text-muted dashboard-card-stats">
                                        @foreach (var stat in card.Stats)
                                        {
                                            <li><span class="fw-semibold text-body">@stat.Value</span> &middot; @stat.Label</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>
    </section>
}
else
{
    <div class="alert alert-info">Sync your Garmin data to unlock dashboard highlights.</div>
}

<style>
    .dashboard-card-link {
        text-decoration: none;
        color: inherit;
    }

    .dashboard-card {
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(33, 37, 41, 0.12);
    }

    .dashboard-card-accent {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .dashboard-card-accent .icon-steps {
        width: 1.5rem;
        height: 1.5rem;
    }

    .dashboard-card-stats li+li {
        margin-top: 0.35rem;
    }

    .accent-steps {
        background: rgba(13, 110, 253, 0.12);
        color: #0d6efd;
    }

    .accent-sleep {
        background: rgba(111, 66, 193, 0.12);
        color: #6f42c1;
    }

    .accent-activity {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    .insights-card {
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.08), rgba(111, 66, 193, 0.05));
    }

    .suggested-workout-bg {
        background: linear-gradient(135deg, rgba(255, 193, 7, 0.08), rgba(255, 152, 0, 0.05));
    }

    .insights-text {
        font-size: 0.92rem;
        line-height: 1.65;
    }

    .insights-text p:last-child {
        margin-bottom: 0;
    }

    .insights-text strong {
        color: var(--bs-primary);
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    (function () {
    // ========== AI Daily Briefing (AJAX + cache) ==========
    const dailyEl = document.getElementById('dailyRecommendation');
    const refreshBtn = document.getElementById('refreshRecommendation');

    if (typeof marked !== 'undefined') {
    marked.setOptions({ breaks: true, gfm: true });
    }

    function renderMd(text) {
    if (!text) return '';
    if (typeof marked !== 'undefined' && marked.parse) return marked.parse(text);
    return text.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]).replace(/\n/g, '<br>');
    }

    function getCacheKey() {
    return 'hat_daily_' + new Date().toISOString().slice(0, 10);
    }

    function renderRecommendation(raw) {
    if (!raw) {
    dailyEl.innerHTML = '<p class="text-muted mb-0">No recommendation available yet. Make sure your AI key is configured.</p>';
    return;
    }

    let parsed = null;
    try {
    const cleaned = raw.replace(/^```(?:json)?\s*/i, '').replace(/\s*```\s*$/i, '').trim();
    parsed = JSON.parse(cleaned);
    } catch { }

    if (parsed && (parsed.recent_summary || parsed.upcoming_outlook)) {
    const hasSuggested = !!parsed.suggested_workout;
    const colClass = hasSuggested ? 'col-lg-4' : 'col-lg-6';
    let html = '<div class="row g-3">';

    if (parsed.recent_summary) {
    html += `<div class="${colClass}">
    <div class="d-flex align-items-start gap-2 h-100">
    <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary" style="width:2.25rem;height:2.25rem;">
    <i class="bi bi-clock-history"></i>
    </div>
    <div>
    <div class="fw-semibold small text-uppercase text-muted mb-1">Recent Summary</div>
    <div class="insights-text">${renderMd(parsed.recent_summary)}</div>
    </div>
    </div>
    </div>`;
    }
    if (parsed.upcoming_outlook) {
    html += `<div class="${colClass}">
    <div class="d-flex align-items-start gap-2 h-100">
    <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success" style="width:2.25rem;height:2.25rem;">
    <i class="bi bi-arrow-right-circle"></i>
    </div>
    <div>
    <div class="fw-semibold small text-uppercase text-muted mb-1">Upcoming Outlook</div>
    <div class="insights-text">${renderMd(parsed.upcoming_outlook)}</div>
    </div>
    </div>
    </div>`;
    }
    if (hasSuggested) {
    html += `<div class="${colClass}">
    <div class="d-flex align-items-start gap-2 h-100 p-2 rounded-3 suggested-workout-bg">
    <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 text-warning" style="width:2.25rem;height:2.25rem;">
    <i class="bi bi-lightning-charge"></i>
    </div>
    <div>
    <div class="fw-semibold small text-uppercase text-muted mb-1">Suggested Workout</div>
    <div class="insights-text">${renderMd(parsed.suggested_workout)}</div>
    </div>
    </div>
    </div>`;
    }
    html += '</div>';
    dailyEl.innerHTML = html;
    } else {
    dailyEl.innerHTML = `<div class="insights-text">${renderMd(raw)}</div>`;
    }
    }

    async function loadRecommendation(forceRefresh) {
    const cacheKey = getCacheKey();
    if (!forceRefresh) {
    const cached = localStorage.getItem(cacheKey);
    if (cached) { renderRecommendation(cached); return; }
    }

    dailyEl.innerHTML = '<div class="d-flex align-items-center gap-2 text-muted"><div class="spinner-border spinner-border-sm" role="status"></div><span>Coach is analyzing your training data, sleep, and calendar...</span></div>';

    try {
    const resp = await fetch('/api/insights/daily');
    if (!resp.ok) { const e = await resp.json().catch(() => ({})); throw new Error(e.error || `HTTP ${resp.status}`); }
    const json = await resp.json();
    const raw = (json.recommendation || '').trim();

    if (raw) {
    // Clear old date keys
    for (let i = localStorage.length - 1; i >= 0; i--) {
    const k = localStorage.key(i);
    if (k && k.startsWith('hat_daily_') && k !== cacheKey) localStorage.removeItem(k);
    }
    localStorage.setItem(cacheKey, raw);
    }
    renderRecommendation(raw);
    } catch (err) {
    dailyEl.innerHTML = `<div class="d-flex align-items-center gap-2 text-danger"><i class="bi bi-exclamation-triangle"></i><span>Unable to load: ${err.message}</span></div>`;
    }
    }

    if (refreshBtn) {
    refreshBtn.addEventListener('click', () => loadRecommendation(true));
    }

    loadRecommendation(false);

    // ========== Feedback ==========
    const feedbackContainer = document.querySelector('.insights-feedback');
    if (!feedbackContainer) return;
    const statusEl = document.getElementById('insightsFeedbackStatus');
    const buttons = Array.from(feedbackContainer.querySelectorAll('button[data-feedback]'));
    feedbackContainer.addEventListener('click', async (event) => {
    const button = event.target.closest('button[data-feedback]');
    if (!button) return;
    const helpful = button.dataset.feedback === 'true';
    buttons.forEach(b => b.disabled = true);
    if (statusEl) statusEl.textContent = 'Sending feedback...';
    try {
    const r = await fetch('/api/insights/feedback', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ helpful }) });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    if (statusEl) statusEl.textContent = helpful ? 'Thanks! We will keep it up.' : 'Thanks! We will fine-tune your tips.';
    } catch { if (statusEl) statusEl.textContent = 'Unable to send feedback right now.'; buttons.forEach(b => b.disabled = false); }
    });
    })();
</script>
@page
@model GarminTempApi.Pages.IndexModel
@using GarminTempApi.Services
@using System
@using System.Globalization
@using System.Linq
@{
    Layout = "_Layout";
    string FormatDateTime(DateTime? value)
    {
        return value is null ? "--" : value.Value.ToLocalTime().ToString("dd MMM yy HH:mm", CultureInfo.InvariantCulture);
    }
    string FormatDateOnly(DateOnly? value)
    {
        if (value is null)
        {
            return "--";
        }

        var asDateTime = value.Value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Unspecified);
        return asDateTime.ToString("dddd, dd MMM yy", CultureInfo.InvariantCulture);
    }

    string[] SplitRecommendation(string? recommendation)
    {
        if (string.IsNullOrWhiteSpace(recommendation))
        {
            return Array.Empty<string>();
        }

        return recommendation
        .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(line => line.Trim())
        .Where(line => line.Length > 0)
        .ToArray();
    }
}

<div class="py-5 text-center">
    <h1>Welcome to your Health Tracker app</h1>
</div>

@if (Model.Summary?.Cards?.Count > 0)
{
    <section class="mb-5">
        <div class="d-flex align-items-baseline justify-content-between mb-3 flex-wrap gap-2">
            <h2 class="h4 mb-0">Your day</h2>
            <div class="text-muted small d-flex flex-wrap gap-2">
                @if (Model.Summary.LatestDataDate is not null)
                {
                    <span>@FormatDateOnly(Model.Summary.LatestDataDate)</span>
                }
                <span>Updated @FormatDateTime(Model.Summary.GeneratedUtc)</span>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var card in Model.Summary.Cards)
            {
                <div class="col">
                    <a class="dashboard-card-link" href="@card.DestinationUrl">
                        <article class="card dashboard-card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column gap-3">
                                <div class="d-flex align-items-start justify-content-between gap-3">
                                    <div>
                                        <div class="text-uppercase small text-muted">@card.Title</div>
                                        <div class="fs-2 fw-semibold">@card.PrimaryValue</div>
                                        @if (!string.IsNullOrWhiteSpace(card.PrimaryCaption))
                                        {
                                            <div class="text-muted small">@card.PrimaryCaption</div>
                                        }
                                    </div>
                                    <span class="dashboard-card-accent @card.AccentCss">
                                        @if (string.Equals(card.IconCss, "icon-steps", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <svg class="icon-steps" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                <path
                                                    d="M4.75 13.75V11.5c0-1.8 1.45-3.25 3.25-3.25h1.15c.63 0 1.22-.3 1.59-.82l1.34-1.85a2 2 0 011.63-.83h1.25c.77 0 1.49.37 1.94.99l1.12 1.57a3.5 3.5 0 001.86 1.29l2.34.64c.88.24 1.53 1.04 1.53 1.95V14a3.5 3.5 0 01-3.5 3.5H6.75a2 2 0 01-2-2Z"
                                                    fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                                    stroke-linejoin="round" />
                                                <path d="M5.5 16.5H17.5" fill="none" stroke="currentColor" stroke-width="1.6"
                                                    stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M9.5 11.5h3" fill="none" stroke="currentColor" stroke-width="1.6"
                                                    stroke-linecap="round" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <i class="@card.IconCss"></i>
                                        }
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(card.Subtitle))
                                {
                                    <div class="text-muted small">@card.Subtitle</div>
                                }
                                @if (card.Stats?.Count > 0)
                                {
                                    <ul class="list-unstyled mb-0 small text-muted dashboard-card-stats">
                                        @foreach (var stat in card.Stats)
                                        {
                                            <li><span class="fw-semibold text-body">@stat.Value</span> &middot; @stat.Label</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>
    </section>
}
else
{
    <div class="alert alert-info">Sync your Garmin data to unlock dashboard highlights.</div>
}

<section class="mb-5">
    <div class="card shadow-sm border-0 insights-card">
        <div class="card-body d-flex flex-column gap-3">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <div class="text-uppercase small text-muted">Today's Recommendation</div>
                    <h2 class="h5 mb-0">Personalized Guidance</h2>
                </div>
                <span class="insights-icon text-primary">
                    <i class="bi-stars"></i>
                </span>
            </div>
            @{
                var recommendationLines = SplitRecommendation(Model.DailyRecommendation);
            }
            @if (recommendationLines.Length > 0)
            {
                <div class="insights-content text-muted">
                    @foreach (var line in recommendationLines)
                    {
                        <p class="mb-2">@line</p>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.DailyRecommendationError))
            {
                <p class="text-muted mb-0">@Model.DailyRecommendationError</p>
            }
            else
            {
                <p class="text-muted mb-0">Daily recommendations will appear once your latest data syncs.</p>
            }
        </div>
    </div>
</section>

<style>
    .dashboard-card-link {
        text-decoration: none;
        color: inherit;
    }

    .dashboard-card {
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(33, 37, 41, 0.12);
    }

    .dashboard-card-accent {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .dashboard-card-accent .icon-steps {
        width: 1.5rem;
        height: 1.5rem;
    }

    .dashboard-card-stats li+li {
        margin-top: 0.35rem;
    }

    .accent-steps {
        background: rgba(13, 110, 253, 0.12);
        color: #0d6efd;
    }

    .accent-sleep {
        background: rgba(111, 66, 193, 0.12);
        color: #6f42c1;
    }

    .accent-activity {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    .insights-card {
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.08), rgba(111, 66, 193, 0.05));
    }

    .insights-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
    }

    .insights-content p:last-child {
        margin-bottom: 0;
    }
</style>
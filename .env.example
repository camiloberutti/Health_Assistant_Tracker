# ──────────────────────────────────────────────
# Health_Assistant_Tracker — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# The .env file is git-ignored and will NOT be committed.

# ── Garmin Connect credentials (required for importing data) ──
GARMIN_USERNAME=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password

# ── Import date range (optional) ──
GARMIN_START_DATE=2025-01-01
GARMIN_END_DATE=2025-12-31
GARMIN_MAX_ACTIVITIES=50

# ── Automatic sync interval in minutes (optional, Docker only) ──
GARMIN_REFRESH_MINUTES=60

# ── OpenAI / ChatGPT (optional — enables the Insights feature) ──
CHATGPT_API_KEY=sk-...your-openai-api-key...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.4
# OPENAI_MAX_TOKENS=400
